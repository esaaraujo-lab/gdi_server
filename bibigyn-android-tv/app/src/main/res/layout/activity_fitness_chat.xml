<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1.44 — Chat da assistente fitness (SÓ celular): cabeçalho com
     a identidade da BiBi (ícone da app — a árvore não tem asset de
     cara fotográfico), mensagens e campo de escrita. A assistente é
     a da nuvem (POST /api/ai, persona fitness-bibi).
     v2.1.47 — linha de chips de temas da Biblioteca de Conhecimento
     entre o cabeçalho e as mensagens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/content_margin"
        android:paddingVertical="@dimen/spacing_sm">

        <TextView
            android:id="@+id/fitnessChatBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/spacing_sm"
            android:text="‹"
            android:textColor="@color/md_primary"
            android:textSize="28sp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="@drawable/avatar_circle"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fitness_chat_title"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_topbar_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fitness_chat_subtitle"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="@dimen/text_card_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline" />

    <!-- v2.1.47 — Chips de temas da Biblioteca de Conhecimento:
         linha horizontal com scroll, acima das mensagens. Os chips
         são criados pela activity (rótulo + pergunta completa) e
         tocam para enviar a pergunta pelo caminho normal do chat. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/content_margin"
        android:paddingVertical="@dimen/spacing_sm"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/fitnessChatChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fitnessChatList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/content_margin"
        android:paddingTop="@dimen/spacing_md" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/content_margin"
        android:paddingVertical="@dimen/spacing_sm">

        <EditText
            android:id="@+id/fitnessChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/card_surface_rounded"
            android:hint="@string/fitness_chat_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="4000"
            android:maxLines="4"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="@color/md_on_surface"
            android:textColorHint="@color/md_on_surface_variant"
            android:textSize="@dimen/text_card_title" />

        <TextView
            android:id="@+id/fitnessChatSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/btn_primary_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:text="@string/fitness_chat_send"
            android:textColor="@color/md_on_primary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
