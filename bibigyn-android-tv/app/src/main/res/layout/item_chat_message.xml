<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1.44 — Bolha do chat fitness: avatar da BiBi (ícone da app)
     + texto. O alinhamento (esq./dir.) e o fundo são aplicados pelo
     adapter. Porte da Meggy 2.7.58. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/chatAvatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:background="@drawable/avatar_circle"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_foreground" />

    <TextView
        android:id="@+id/chatBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.25"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textSize="@dimen/text_card_title" />
</LinearLayout>
