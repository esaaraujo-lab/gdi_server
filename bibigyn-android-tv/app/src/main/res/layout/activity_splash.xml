<?xml version="1.0" encoding="utf-8"?>
<!-- 2.1.40 — Splash animado: o vídeo (celular = profundidade, TV = letra a
     letra) ocupa o tela inteiro. Fundo preto: os vídeos já têm fundo escuro,
     por isso eventuais barras do resize_mode="fit" ficam invisíveis.
     Sem controller, sem buffering visível — só o vídeo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/splash_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        app:use_controller="false"
        app:resize_mode="fit"
        app:show_buffering="never" />

</FrameLayout>
