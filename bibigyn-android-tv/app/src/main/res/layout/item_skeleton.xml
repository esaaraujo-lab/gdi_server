<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.0.0 — Skeleton placeholder used by the home rails while data
  loads. Pulsing gray tile matches the 200dp × 200dp rail-card size
  so the layout doesn't jump when real data arrives.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="200dp"
    android:layout_marginEnd="12dp">
    <View
        android:id="@+id/skeleton_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/skeleton_block" />
</FrameLayout>
