<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme — Material 3, dark, Meggy pink/purple accents. -->
    <style name="Theme.Meggy" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowBackground">@color/md_background</item>

        <!-- Cards / dialogs use surface elevated -->
        <item name="materialCardViewStyle">@style/Widget.Meggy.CardView</item>
    </style>

    <!-- Splash theme — no action bar, gradient background, no content until activity loads. -->
    <style name="Theme.Meggy.Splash" parent="Theme.Meggy">
        <item name="android:windowBackground">@drawable/gradient_meggy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Card style for the drive / file grid -->
    <style name="Widget.Meggy.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/md_surface_container</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Meggy.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/md_primary_container</item>
        <item name="android:textColor">@color/md_on_primary_container</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Text inputs -->
    <style name="Widget.Meggy.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/md_primary</item>
        <item name="boxBackgroundColor">@color/md_surface_variant</item>
        <item name="hintTextColor">@color/md_primary</item>
    </style>

    <!-- Title text used on splash and login -->
    <style name="TextAppearance.Meggy.Title" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Meggy.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/white_overlay</item>
    </style>

</resources>
