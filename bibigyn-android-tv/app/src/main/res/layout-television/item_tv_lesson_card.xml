<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1.41 — cartão da fileira de aulas do detalhe TV (conceito
     "tv-detalhe-video"): thumb 16:9 com ✓ verde quando assistido;
     "Aula N", nome da aula e meta (duração quando conhecida •
     Assistido / Assistindo agora). Só existe em layout-television:
     o adapter (TvLessonRailAdapter) só é criado na TV. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lessonCardRoot"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/elevation_0"
    app:cardBackgroundColor="@color/tile_bg"
    app:strokeWidth="0dp"
    app:strokeColor="@color/tile_focus_ring_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="141dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_gradient_pink" />

            <ImageView
                android:id="@+id/lessonThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@string/thumb_desc" />

            <TextView
                android:id="@+id/lessonWatchedBadge"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/ic_watched_circle"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/md_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/lessonNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/md_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lessonName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/tile_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lessonMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tile_subtitle"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
