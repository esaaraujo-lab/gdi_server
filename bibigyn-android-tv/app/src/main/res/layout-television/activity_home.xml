<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.1.44 — Home TV estilo Plex (porte da Meggy 2.7.56/2.7.58,
  adaptado à BiBi): o menu fixo de 264dp sai; entra o rail retrátil
  SideMenuView (56dp em repouso, expande ao foco e DESLIZA sobre o
  conteúdo, que vive em homeContent com a margem fixa de 56dp e
  nunca refluí). No topo, o HERO AMBIENTE segue o foco (backdrop do
  item focado + título + meta + progresso); os cartões do Continuar
  são uniformes 16:9 (imagem + progresso na aresta + título por
  baixo, sem corpo colorido). O hero de drives e a seção de destaque
  ficam no layout (o ViewBinding partilhado referencia-os) mas na TV
  ficam GONE — o topo é do hero ambiente (decisões do Elton
  2026-11-25 19:20–19:24, via Meggy 2.7.58).
  Mesmos ids do layout de celular (ViewBinding único) + ids novos
  só-TV (homeContent, homeTopBar, ambient*), acedidos com
  findViewById no código.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="56dp"
        android:background="@color/md_background"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/tv_margin_side"
        android:paddingTop="@dimen/tv_margin_top"
        android:paddingBottom="@dimen/tv_margin_bottom">

        <!-- Topo: logo + sair (some com o rail ligado — o Sair vive
             no rodapé do rail; ver setupSideMenu) -->
        <LinearLayout
            android:id="@+id/homeTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/topTitle"
                android:text="@string/app_name"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/tv_title_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/topSair"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/focus_ring_transparent"
                android:focusableInTouchMode="true"
                android:padding="@dimen/spacing_sm"
                android:text="@string/home_logout"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="@dimen/tv_body" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/homeScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false">

                <!-- Hero ambiente (v2.1.44): segue o foco — backdrop
                     do item focado na fileira Continuar/Drives +
                     título + meta + progresso. Sem foco ainda (ou
                     sem itens), mostra a aula em curso (o "best" do
                     Continuar). NÃO é focável: é ambiente.
                     v2.1.46: cantos arredondados de 24dp com recorte
                     real (fundo ambient_hero_bg + clipToOutline),
                     anel laranja da marca por cima (ambientHeroRing)
                     e scrim translúcido sobre a imagem (antes era o
                     hero_gradient OPACO, que tapava a imagem e o
                     bloco parecia um rectângulo de cor lisa). -->
                <FrameLayout
                    android:id="@+id/ambientHero"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:background="@drawable/ambient_hero_bg"
                    android:clipToOutline="true"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ambientImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/thumb_desc"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/hero_scrim" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp"
                        android:paddingBottom="24dp">

                        <TextView
                            android:id="@+id/ambientTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:shadowColor="#000000"
                            android:shadowDx="0"
                            android:shadowDy="2"
                            android:shadowRadius="8"
                            android:textColor="@android:color/white"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ambientMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/md_primary"
                            android:textSize="17sp" />

                        <ProgressBar
                            android:id="@+id/ambientProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="320dp"
                            android:layout_height="6dp"
                            android:layout_marginTop="12dp"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_horizontal"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/ambientPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/btn_primary_pill"
                            android:focusable="false"
                            android:paddingHorizontal="22dp"
                            android:paddingVertical="10dp"
                            android:text="@string/ambient_continue"
                            android:textColor="@color/md_on_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- v2.1.46 — Anel luminoso do hero (feedback
                         visual): por cima de todo o conteúdo, só a
                         borda; visível sempre que o hero está. -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ambient_hero_ring"
                        android:focusable="false" />
                </FrameLayout>

                <!-- Hero de drives (na TV 2.1.44 fica GONE — o topo
                     é do hero ambiente; mantido p/ o binding e p/ o
                     modo sem rail). -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tv_hero_height"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/elevation_0"
                    app:cardBackgroundColor="@color/tile_bg">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <View
                            android:id="@+id/heroBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/hero_gradient" />

                        <ImageView
                            android:id="@+id/heroThumb"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="@string/thumb_desc" />

                        <View
                            android:id="@+id/heroScrim"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/hero_scrim" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/tv_hero_text_padding_side"
                            android:paddingVertical="@dimen/tv_section_spacing">

                            <TextView
                                android:id="@+id/heroBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/chip_badge"
                                android:paddingHorizontal="@dimen/spacing_lg"
                                android:paddingVertical="@dimen/spacing_sm"
                                android:textColor="@color/md_primary"
                                android:textSize="@dimen/tv_chip_text"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/heroTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/md_on_surface"
                                android:textSize="@dimen/tv_title_lg"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/heroSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/tv_body_lg" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/heroPlay"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:background="@drawable/btn_primary_pill"
                                android:focusable="true"
                                android:paddingHorizontal="@dimen/spacing_2xl"
                                android:text="@string/explore_cta"
                                android:textColor="@color/md_on_primary"
                                android:textSize="@dimen/tv_button_text"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Seção de destaque (na TV 2.1.44 fica GONE — o
                     item em curso é o 1.º cartão da fileira e o topo
                     é do hero ambiente; no celular é o cartão
                     Continuar da Home). -->
                <LinearLayout
                    android:id="@+id/featuredSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/featured_card"
                        android:layout_width="match_parent"
                        android:layout_height="400dp"
                        android:clickable="true"
                        android:descendantFocusability="blocksDescendants"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/radius_lg"
                        app:cardElevation="@dimen/elevation_0"
                        app:cardBackgroundColor="@color/tile_bg"
                        app:strokeWidth="0dp"
                        app:strokeColor="@color/tile_focus_ring">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:id="@+id/featuredBg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/card_gradient_pink" />

                            <ImageView
                                android:id="@+id/featuredThumb"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"
                                android:contentDescription="@string/thumb_desc" />

                            <TextView
                                android:id="@+id/featuredDriveArt"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="@color/tile_title"
                                android:textSize="56sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/hero_scrim" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:orientation="vertical"
                                android:paddingHorizontal="32dp"
                                android:paddingTop="26dp"
                                android:paddingBottom="26dp">

                                <TextView
                                    android:id="@+id/featuredTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="@color/md_on_surface"
                                    android:textSize="36sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/featuredSubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/md_on_surface_variant"
                                    android:textSize="17sp" />

                                <ProgressBar
                                    android:id="@+id/featuredProgress"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:layout_marginTop="18dp"
                                    android:max="100"
                                    android:progressDrawable="@drawable/progress_horizontal" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/featuredProgressText"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:textColor="@color/md_primary"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/featuredTimeText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/md_on_surface_variant"
                                        android:textSize="15sp" />
                                </LinearLayout>

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/featuredContinue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="56dp"
                                    android:layout_marginTop="18dp"
                                    android:background="@drawable/btn_primary_pill"
                                    android:focusable="true"
                                    android:paddingHorizontal="@dimen/spacing_2xl"
                                    android:text="@string/cta_continue"
                                    android:textColor="@color/md_on_primary"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Continue assistindo (cartões uniformes 16:9) -->
                <TextView
                    android:id="@+id/labelContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:text="@string/continue_watching"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/railContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:clipChildren="false"
                    android:overScrollMode="never" />

                <!-- Explorar drives -->
                <TextView
                    android:id="@+id/labelDrives"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:text="@string/explore_drives"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/railDrives"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:clipChildren="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/footerVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:gravity="center"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />
            </LinearLayout>
        </ScrollView>

        <!-- Sem bottom nav na TV -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:menu="@menu/bottom_nav_menu" />
    </LinearLayout>

    <!-- Rail lateral estilo Plex (por cima do conteúdo) -->
    <com.bibigyn.app.ui.home.SideMenuView
        android:id="@+id/tvSideMenu"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
