<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.1.41 — Detalhe TV novo (conceito aprovado "tv-detalhe-video"):
  TV SÓ VÍDEO — sem abas Resumo/Questões/Flashcards e sem chips de
  materiais/pastas (as vistas ficam no layout, gone, porque o
  ViewBinding e o código partilhado as referenciam; o código força
  GONE + aba Aulas na TV e nem carrega os materiais).
  Cabeçalho imersivo: fundo full-bleed (thumb da aula do resume ou
  da 1.ª aula), título grande, botões "Continuar Assistindo" e
  "Assistir do Início", progresso do curso (linha + barra larga) e,
  abaixo, a fileira horizontal de aulas + a navegação de sempre
  (rail Continue + grade/lista de subpastas, ids inalterados).
  Mesmos ids do layout de celular (ViewBinding único) + ids novos
  só-TV (ctaFromStart, tvCourseProgress*, tvLessons*), acedidos
  com ?. no código.

  v2.1.44 — rail lateral estilo Plex persistente (TvRailHost): a
  raiz passa a FrameLayout, o conteúdo vive em detailContent com a
  margem fixa de 56dp e o SideMenuView desliza por cima. A faixa do
  herói passa a 200dp e SÓ aparece onde a pasta tem vídeos directos
  (regra da Meggy 2.7.56; a visibilidade é do updateTvDetailHeader,
  id heroCard via findViewById) — pasta intermédia fica sem faixa.
  O progresso do curso sai de dentro da faixa (fica abaixo dela).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <LinearLayout
        android:id="@+id/detailContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="56dp"
        android:background="@color/md_background"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/tv_margin_side"
        android:paddingTop="@dimen/tv_margin_top"
        android:paddingBottom="@dimen/tv_margin_bottom">

    <!-- Toolbar (oculta na TV; mantida para o binding) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:titleTextColor="@color/md_on_surface" />

    <!-- Header TV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/md_on_surface"
            android:textSize="@dimen/tv_title_md"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/headerSearch"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:clickable="true"
            android:contentDescription="Buscar"
            android:focusable="true"
            android:background="@drawable/focus_ring_transparent"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/ctaContinue"
            android:padding="12dp"
            android:src="@drawable/ic_search"
            android:tint="@color/md_on_surface" />

        <TextView
            android:id="@+id/headerAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/spacing_lg"
            android:background="@drawable/btn_play_circle"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center"
            android:textColor="@color/md_on_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false">

            <!-- Faixa-backdrop (v2.1.44): 200dp, SÓ onde a pasta
                 tem vídeos directos; pasta intermédia fica SEM
                 faixa (visibilidade no updateTvDetailHeader).
                 Conteúdo aparado p/ caber nos 200dp: título 1
                 linha 30sp, subtítulo 14sp, botões 48dp. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/tv_section_spacing"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_0"
                app:cardBackgroundColor="@color/tile_bg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/heroBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_gradient_pink" />

                    <ImageView
                        android:id="@+id/heroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@string/thumb_desc" />

                    <TextView
                        android:id="@+id/heroMonogram"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/tile_title"
                        android:textSize="72sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/hero_scrim" />

                    <TextView
                        android:id="@+id/heroPlayFab"
                        android:layout_width="@dimen/tv_play_fab_size"
                        android:layout_height="@dimen/tv_play_fab_size"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_play_circle"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusRight="@id/ctaContinue"
                        android:nextFocusDown="@id/ctaContinue"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="@color/md_on_primary"
                        android:textSize="48sp" />

                    <TextView
                        android:id="@+id/heroFav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/spacing_lg"
                        android:background="@drawable/badge_resume"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusLeft="@id/heroPlayFab"
                        android:nextFocusDown="@id/ctaContinue"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:text="☆  Salvar"
                        android:textColor="@color/tile_title"
                        android:textSize="@dimen/tv_chip_text" />

                    <!-- Título + botões + progressos, sobre o gradiente -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/md_on_surface"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/md_primary"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/ctaContinue"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:background="@drawable/btn_primary_pill"
                                android:focusable="true"
                                android:nextFocusUp="@id/heroPlayFab"
                                android:nextFocusRight="@id/ctaFromStart"
                                android:nextFocusDown="@id/tvLessonsRail"
                                android:paddingHorizontal="@dimen/spacing_2xl"
                                android:text="@string/cta_continue"
                                android:textColor="@color/md_on_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/ctaFromStart"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="14dp"
                                android:background="@drawable/btn_outline_pill"
                                android:focusable="true"
                                android:nextFocusLeft="@id/ctaContinue"
                                android:nextFocusDown="@id/tvLessonsRail"
                                android:paddingHorizontal="@dimen/spacing_2xl"
                                android:text="@string/cta_from_start"
                                android:textColor="@color/md_on_surface"
                                android:textSize="15sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- Progresso da aula em curso (ids de sempre) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/heroTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tile_title"
                                android:textSize="@dimen/tv_time_text"
                                android:textStyle="bold" />

                            <ProgressBar
                                android:id="@+id/heroProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="6dp"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progressDrawable="@drawable/progress_horizontal" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progresso do curso (v2.1.44: fora da faixa de
                 200dp, logo abaixo dela; ids de sempre) -->
            <TextView
                android:id="@+id/tvCourseProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/md_on_surface"
                android:textSize="15sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/tvCourseProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_horizontal"
                android:visibility="gone" />

            <!-- Chips (mantidos p/ o binding; GONE na TV — regra
                 "TV só vídeo": sem contagem de aulas/pastas/materiais) -->
            <LinearLayout
                android:id="@+id/chipsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/chipCount"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:background="@drawable/chip_outline"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_chip_text" />

                <TextView
                    android:id="@+id/chipProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/chip_outline"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_chip_text" />
            </LinearLayout>

            <!-- Abas (mantidas p/ o binding; GONE na TV — TV só vídeo) -->
            <LinearLayout
                android:id="@+id/tabsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/tabResumo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/focus_ring_transparent"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tabResumoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_summary"
                        android:textColor="@color/md_primary"
                        android:textSize="@dimen/tv_body"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/tabIndicatorResumo"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/md_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabAulas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/focus_ring_transparent"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tabAulasLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_lessons"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="@dimen/tv_body" />

                    <View
                        android:id="@+id/tabIndicatorAulas"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabQuestoes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/focus_ring_transparent"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tabQuestoesLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_questions"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="@dimen/tv_body" />

                    <View
                        android:id="@+id/tabIndicatorQuestoes"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabFlashcards"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/focus_ring_transparent"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tabFlashcardsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_flashcards"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="@dimen/tv_body" />

                    <View
                        android:id="@+id/tabIndicatorFlashcards"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>
            </LinearLayout>

            <!-- Painel: Resumo (mantido p/ o binding; nunca é
                 seleccionado na TV e nem é carregado — TV só vídeo) -->
            <LinearLayout
                android:id="@+id/panelResumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/resumoState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_primary"
                    android:textSize="@dimen/tv_chip_text" />

                <TextView
                    android:id="@+id/resumoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_body" />

                <TextView
                    android:id="@+id/detailFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:gravity="end"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />
            </LinearLayout>

            <!-- Painel: Aulas -->
            <LinearLayout
                android:id="@+id/panelAulas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone"
                    app:boxBackgroundColor="@color/md_surface_container"
                    app:boxCornerRadiusTopStart="28dp"
                    app:boxCornerRadiusTopEnd="28dp"
                    app:boxCornerRadiusBottomStart="28dp"
                    app:boxCornerRadiusBottomEnd="28dp"
                    app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/lessonSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Buscar aula…"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:textColor="@color/md_on_surface"
                        android:textColorHint="@color/md_on_surface_variant"
                        android:textSize="@dimen/tv_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/labelContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:text="@string/continue_from_where"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/railContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:clipChildren="false"
                    android:overScrollMode="never"
                    android:visibility="gone" />

                <!-- Fileira de aulas da pasta (v2.1.41, só TV) -->
                <TextView
                    android:id="@+id/tvLessonsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:text="@string/tab_lessons"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tvLessonsRail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:clipChildren="false"
                    android:overScrollMode="never"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:text="@string/tab_lessons"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clipToPadding="false"
                    android:padding="16dp"
                    android:clipChildren="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <ProgressBar
                    android:id="@+id/loadingView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:gravity="center"
                    android:text="@string/browse_empty"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Painel: Questões (mantido p/ o binding; GONE na TV) -->
            <LinearLayout
                android:id="@+id/panelQuestoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/questoesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/no_questions"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />
            </LinearLayout>

            <!-- Painel: Flashcards (mantido p/ o binding; GONE na TV) -->
            <LinearLayout
                android:id="@+id/panelFlashcards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/flashcardsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/no_flashcards"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Sem bottom nav na TV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:menu="@menu/bottom_nav_menu" />
    </LinearLayout>

    <!-- v2.1.44 — rail lateral estilo Plex (por cima do conteúdo) -->
    <com.bibigyn.app.ui.home.SideMenuView
        android:id="@+id/tvSideMenu"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
