<?xml version="1.0" encoding="utf-8"?>
<!-- v2.7.9 — Botão redondo de play do player: rosa no estado normal
     (igual a btn_play_circle), anel claro quando focado/pressionado.
     btn_play_circle é um shape estático — sem feedback visual. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/player_play_ring" />
    <item android:state_focused="true" android:drawable="@drawable/player_play_ring" />
    <item android:drawable="@drawable/btn_play_circle" />
</selector>
