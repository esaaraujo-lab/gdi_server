<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.8.0 — Disney+/Netflix-style bottom scrim that fades from transparent
  at the top to deep ink at the bottom. Lets the title + subtitle sit on
  top of any tile thumbnail without losing contrast.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#00000000"
        android:centerColor="#80000000"
        android:endColor="#F00D0E12"
        android:angle="270"
        android:type="linear" />
    <corners android:radius="0dp" />
</shape>
