<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.1.44 — Fundo das linhas do menu lateral TV (porte Meggy 2.7.56,
  réplica Plex): a linha COM FOCO é uma pílula SÓLIDA na cor da marca
  da BiBi (ícone e rótulo brancos via ColorStateList com
  duplicateParentState — ver SideMenuView); a linha SELECCIONADA sem
  foco (página actual) leva a tinta da marca a 16% (#29FF6B35 =
  md_primary #FF6B35 a 16%). Raio 12dp. Repouso transparente.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/md_primary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#29FF6B35" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
