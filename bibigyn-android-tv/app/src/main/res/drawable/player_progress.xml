<?xml version="1.0" encoding="utf-8"?>
<!-- Frente E / R3A — Barra de progresso do player (SO o player; os cards
     continuam com progress_horizontal.xml, que NAO e tocado): trilho
     fino de 5dp (insets de 15dp num SeekBar de 35dp, Plyr: track 5px)
     — trilho branco 25% (era 12%; Plyr #ffffff40), preenchimento na cor
     da marca a 70% (player_progress_fill, por app). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background"
        android:top="15dp"
        android:bottom="15dp">
        <shape>
            <corners android:radius="2dp" />
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress"
        android:top="15dp"
        android:bottom="15dp">
        <clip>
            <shape>
                <corners android:radius="2dp" />
                <solid android:color="@color/player_progress_fill" />
            </shape>
        </clip>
    </item>
</layer-list>
