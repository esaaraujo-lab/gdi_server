<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.8.0 — Pink glow ring drawn behind a tile when it has focus.
  Set on the outer FrameLayout as background when hasFocus=true, removed
  when hasFocus=false. Layer 1 = blurred pink halo, Layer 2 = crisp border.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer halo (soft) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="#33FF8B9F" />
            <corners android:radius="18dp" />
            <padding
                android:left="6dp"
                android:top="6dp"
                android:right="6dp"
                android:bottom="6dp" />
        </shape>
    </item>
    <!-- Inner crisp border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="#FFFF8B9F" />
            <corners android:radius="14dp" />
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp" />
        </shape>
    </item>
</layer-list>
