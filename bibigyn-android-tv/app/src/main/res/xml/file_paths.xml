<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1.5 — FileProvider para compartilhar PDFs baixados (leitor de PDF). -->
<paths>
    <cache-path name="pdfs" path="pdfs/" />
    <cache-path name="downloads" path="downloads/" />
    <!-- §9 (GOLDEN_RULES.md) — APK de atualização na pasta pública Download:
         o FileProvider só serve ficheiros sob um root aqui declarado. Sem
         este <external-path>, getUriForFile() rebenta com
         IllegalArgumentException e o instalador nunca abre (foi o que
         acontecia até aqui: só havia <cache-path>). -->
    <external-path name="public_download" path="Download/" />
</paths>
