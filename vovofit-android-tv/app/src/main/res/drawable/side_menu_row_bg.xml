<?xml version="1.0" encoding="utf-8"?>
<!--
  1.0.40 — Fundo das linhas do menu lateral TV (estilo Plex, porte do
  pacote Meggy 2.7.58 adaptado à marca da Vovó): a linha COM FOCO é
  uma pílula SÓLIDA na cor primária (lima da Vovó Fit; ícone e rótulo
  em md_on_primary escuro via ColorStateList com
  duplicateParentState — ver SideMenuView — contraste legível para
  o público +60); a linha SELECCIONADA sem foco (página actual) leva
  a tinta da marca a 16%. Raio 12dp. Repouso transparente.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/md_primary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#29A3E635" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
