<?xml version="1.0" encoding="utf-8"?>
<!-- 1.0.40 — Meus Cursos (TV): mesmo conteúdo do celular, com
     margens/tipos de TV. O rail lateral é injectado por código
     (TvRailHost) — a margem de 56dp é aplicada por ele, não aqui.
     Tipos NÃO reduzidos face ao que a Vovó já usa na TV (+60). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/tv_margin_side"
    android:paddingVertical="@dimen/tv_margin_top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/myCoursesToolbarBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/spacing_sm"
            android:text="‹"
            android:textColor="@color/md_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="@string/my_courses_title"
            android:textColor="@color/md_on_surface"
            android:textSize="@dimen/tv_title_md"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/myCoursesGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp" />

        <ProgressBar
            android:id="@+id/myCoursesLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/myCoursesState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="@dimen/tv_body_lg"
                android:visibility="gone" />

            <Button
                android:id="@+id/myCoursesRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/retry_action"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
