<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.0.4 — Linha da aula (pasta expansível, conceito "escolher aulas"
  celular): ícone de pasta rosa + título (2 linhas) + meta/progresso
  + selo "Concluída" + chevron. Expande mostrando os filhos
  (item_lesson_child): vídeo, PDF, pasta de PDFs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tile_focus_border"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/lessonIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Pasta da aula"
            android:src="@drawable/ic_folder"
            android:tint="@color/md_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lessonTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lessonMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="@dimen/text_card_subtitle" />
        </LinearLayout>

        <TextView
            android:id="@+id/lessonBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:background="@drawable/chip_badge"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_xs"
            android:text="Concluída"
            android:textColor="@color/md_primary"
            android:textSize="@dimen/text_card_progress"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lessonContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:background="@drawable/btn_primary_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_xs"
            android:text="Continuar"
            android:textColor="@color/md_on_primary"
            android:textSize="@dimen/text_card_progress"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lessonChevron"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/badge_resume"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/md_on_surface"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lessonProgressRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/lessonProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:max="100"
            android:progressDrawable="@drawable/progress_horizontal" />

        <TextView
            android:id="@+id/lessonProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:textColor="@color/md_primary"
            android:textSize="@dimen/text_card_progress" />
    </LinearLayout>
</LinearLayout>
