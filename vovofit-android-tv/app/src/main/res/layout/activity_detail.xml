<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.1.0 — Detail screen layout.
  Netflix-style hero banner at top + grid of tiles below.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_primary"
        android:elevation="0dp"
        app:titleTextColor="@color/text_primary"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:navigationIconTint="@color/meggy_pink" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Banner -->
            <FrameLayout
                android:id="@+id/detail_hero"
                android:layout_width="match_parent"
                android:layout_height="240dp">

                <!-- Gradient background -->
                <View
                    android:id="@+id/hero_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_gradient" />

                <!-- Bottom scrim -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/tile_overlay_bottom" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/hero_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📂 PASTA"
                        android:textColor="@color/meggy_pink"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/hero_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:layout_marginBottom="8dp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/hero_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B5C0CC"
                        android:textSize="13sp"
                        android:layout_marginBottom="18dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/hero_play"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▶  Assistir"
                            android:background="#FFFFFFFF"
                            android:textColor="#FF000000"
                            android:paddingHorizontal="28dp"
                            android:paddingVertical="10dp"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:stateListAnimator="@null"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:clickable="true" />

                        <Button
                            android:id="@+id/hero_browse"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Explorar"
                            android:background="#33FFFFFF"
                            android:textColor="#FFFFFFFF"
                            android:paddingHorizontal="22dp"
                            android:paddingVertical="10dp"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:layout_marginStart="10dp"
                            android:stateListAnimator="@null"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:clickable="true" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Section label -->
            <TextView
                android:id="@+id/section_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conteúdos"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="10dp" />

            <!-- ★ v2.2.0: Continue de onde parou rail (per-drive recents) -->
            <TextView
                android:id="@+id/label_continue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue de onde parou"
                android:textColor="@color/meggy_pink"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rail_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="14dp"
                android:paddingBottom="6dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                android:paddingBottom="24dp" />

            <!-- Loading skeleton -->
            <ProgressBar
                android:id="@+id/loading_view"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:visibility="gone"
                android:indeterminateTint="@color/meggy_pink" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="40dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="56sp"
                    android:text="📭" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Pasta vazia."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
