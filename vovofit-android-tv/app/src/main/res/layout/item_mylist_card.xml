<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.0.4 — Card da Minha lista (conceito): linha horizontal com chip de
  tipo (CURSO/AULA), thumb/monograma, título, metadados, barra de
  progresso + % (aulas), ★ rosa à direita e botão "Continuar" (cursos).
  "N de M aulas" NÃO existe sem listar a pasta — omitido (documentado).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    android:background="@drawable/tile_focus_border"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_md">

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="64dp">

        <View
            android:id="@+id/mylistBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_gradient_pink" />

        <ImageView
            android:id="@+id/mylistThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/thumb_desc" />

        <TextView
            android:id="@+id/mylistMonogram"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/tile_title"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mylistTypeChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_badge"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="2dp"
            android:textColor="@color/md_primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mylistTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/md_on_surface"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mylistMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="@dimen/text_card_subtitle" />

        <LinearLayout
            android:id="@+id/mylistProgressRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/mylistProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/progress_horizontal" />

            <TextView
                android:id="@+id/mylistProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:textColor="@color/md_primary"
                android:textSize="@dimen/text_card_progress" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/mylistContinue"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/btn_primary_pill"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:text="Continuar"
            android:textColor="@color/md_on_primary"
            android:textSize="@dimen/text_chip"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/mylistFav"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top"
        android:background="@drawable/badge_resume"
        android:clickable="true"
        android:contentDescription="@string/fav_desc"
        android:focusable="true"
        android:gravity="center"
        android:text="★"
        android:textColor="@color/md_primary"
        android:textSize="18sp" />
</LinearLayout>
