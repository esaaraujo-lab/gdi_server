<?xml version="1.0" encoding="utf-8"?>
<!-- 1.0.40 — Chat da assistente fitness (celular): cabeçalho com a
     identidade da Vovó Fit, mensagens e campo de escrita. A
     assistente vive no servidor (POST /api/ai, persona fitness-vovo).
     Porte do layout do chat da Meggy 2.7.58. SEM variante de TV:
     na TV não há chat.
     1.0.42 — Barra de chips de temas da BIBLIOTECA DE CONHECIMENTO
     do servidor (fichas vovo-* e sup-* do INDICE): tocar num chip
     envia a pergunta pelo caminho normal do chat. Alvos de 52dp e
     texto de 18sp (legibilidade +60). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/content_margin"
        android:paddingVertical="@dimen/spacing_sm">

        <TextView
            android:id="@+id/assistenteBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/spacing_sm"
            android:text="‹"
            android:textColor="@color/md_primary"
            android:textSize="28sp" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="@drawable/avatar_circle"
            android:clipToOutline="true"
            android:contentDescription="@string/assistente_title"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground_img" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assistente_title"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_topbar_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/assistente_subtitle"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="@dimen/text_card_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline" />

    <!-- 1.0.42 — Chips de temas da biblioteca (perguntas prontas).
         O clique é ligado na activity; o texto enviado é a string
         assistente_q_* correspondente, não o rótulo do botão. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/content_margin"
            android:paddingVertical="@dimen/spacing_sm">

            <TextView
                android:id="@+id/chipForca"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/assistente_chip_height"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/chip_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:text="@string/assistente_chip_forca"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_assistente_chip" />

            <TextView
                android:id="@+id/chipProteina"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/assistente_chip_height"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/chip_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:text="@string/assistente_chip_proteina"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_assistente_chip" />

            <TextView
                android:id="@+id/chipEquilibrio"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/assistente_chip_height"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/chip_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:text="@string/assistente_chip_equilibrio"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_assistente_chip" />

            <TextView
                android:id="@+id/chipVitaminas"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/assistente_chip_height"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/chip_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:text="@string/assistente_chip_vitaminas"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_assistente_chip" />

            <TextView
                android:id="@+id/chipTirzepatida"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/assistente_chip_height"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/chip_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:text="@string/assistente_chip_tirzepatida"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_assistente_chip" />

            <TextView
                android:id="@+id/chipArtrose"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/assistente_chip_height"
                android:background="@drawable/chip_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:text="@string/assistente_chip_artrose"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_assistente_chip" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/assistenteList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/content_margin"
        android:paddingTop="@dimen/spacing_md" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/content_margin"
        android:paddingVertical="@dimen/spacing_sm">

        <EditText
            android:id="@+id/assistenteInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/card_surface_rounded"
            android:hint="@string/assistente_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="4000"
            android:maxLines="4"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="@color/md_on_surface"
            android:textColorHint="@color/md_on_surface_variant"
            android:textSize="@dimen/text_card_title" />

        <TextView
            android:id="@+id/assistenteSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/btn_primary_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:text="@string/assistente_send"
            android:textColor="@color/md_on_primary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
