<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.0.4 — Resultado de busca (conceito Buscar): card horizontal com
  thumb/monograma à esquerda, título (2 linhas), metadados,
  barra de progresso + % e pill "Em andamento" quando retomável.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    android:background="@drawable/tile_focus_border"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_md">

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="64dp">

        <View
            android:id="@+id/resultBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_gradient_pink" />

        <ImageView
            android:id="@+id/resultThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/thumb_desc" />

        <TextView
            android:id="@+id/resultMonogram"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/tile_title"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/md_on_surface"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="@dimen/text_card_subtitle" />

        <LinearLayout
            android:id="@+id/resultProgressRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/resultProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/progress_horizontal" />

            <TextView
                android:id="@+id/resultProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:textColor="@color/md_primary"
                android:textSize="@dimen/text_card_progress" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/resultPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/chip_badge"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_xs"
        android:text="Em andamento"
        android:textColor="@color/md_primary"
        android:textSize="@dimen/text_card_progress"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
