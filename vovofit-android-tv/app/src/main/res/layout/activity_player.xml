<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.0.7 — Player (conceitos player celular + player TV v2) + simplificação
  v1.0.7 (Elton 11:48): barra cinematografica — disco escuro modesto,
  chips como icones discretos (state layer), scrim 72% na base.
  Frente E — controlos discretos: play/pausa 48dp (era 64dp),
  barra de progresso fina de 4dp e mais transparente, scrim 60%.
  Frente R3A (Plyr) — botao play/pausa da barra SO-ICONE (sem disco,
  40dp, glifo 18sp); disco central 44dp; progresso 5dp, thumb 13dp,
  trilho branco 25%; scrim da base 75% (gradiente Plyr).
  do player (Elton 10:31, patch 1.0.5).
  Dois modos, mesma activity:
  • Retrato (celular): vídeo 16:9 no topo + controles abaixo (tempo,
    velocidade, Descanso, tela cheia) + título + curso +
    Anterior/Próxima + bottom nav. Controller nativo do ExoPlayer ativo
    (com botão de tela cheia — setFullscreenButtonClickListener).
    A linha de controles tem DUAS linhas (tempo em cima, pills embaixo)
    porque os 5 elementos não cabem numa só linha em telas de 360dp —
    antes o botão de tela cheia caía para fora da tela e o tempo era
    esmagado para 0dp (a linha tinha −10s/+10s + 4 pills + tempo).
  • Fullscreen (celular, via botão ou girando o aparelho; TV, sempre):
    vídeo ocupa a tela, barra de controles grande embaixo (pause rosa,
    Descanso, CC, velocidade, sair da tela cheia) + tempo + progresso.
    Controller nativo desligado; barra própria. O container do vídeo
    preenche a tela em fullscreen (sem o ratio 16:9, que em paisagem
    de celular — tela mais larga que 16:9 — deixava a barra fora da
    área visível); em retrato volta o 16:9.
  Áudio (mp3/podcast): MESMO player — a área de vídeo vira a CAPA
  do episódio (thumb/monograma); sem CC; mesmos controles, mesmo
  progresso/retomada e Descanso. SEM logo sobre o vídeo (verificado:
  o player antigo não desenhava logo nenhum — e nenhum foi adicionado).
  Descanso (🌙, modo existente v1.3.0; Frente D: TELA CHEIA + persiste
  na troca de aula): overlay preto sobre a tela toda (último filho da
  raiz, elevation 16dp); áudio e progresso continuam; a troca de aula
  (auto-advance ou Anterior/Próxima) NÃO sai do descanso; a saída é o
  toque no overlay, BACK, D-pad ou um botão de controle.
  SIMPLIFICAÇÃO 1.0.5 (o que SAIU daqui):
  • Playlist embutida REMOVIDA (gaveta lateral + botão ☰ no topo +
    seção "A seguir"): a playlist vive na PÁGINA (DetailActivity);
    o avanço (Anterior/Próxima + autoplay) continua igual.
  • Botões −10s/+10s REMOVIDOS do rodapé (barra fullscreen e linha
    retrato): o avanço/retrocesso continua por double-tap nas laterais
    (celular) e setas do D-pad (TV, com controles escondidos ou foco
    no vídeo) — ver PlayerActivity.dispatchKeyEvent.
  • Velocidade NÃO fica no topo do vídeo: só nas barras de controles
    (pill pequena 1.0×), com a "Velocidade padrão" dos Ajustes valendo
    na abertura e ao avançar de aula — ver PlayerActivity.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Área do vídeo / capa de áudio -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:animation_enabled="true"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:surface_type="surface_view"
            app:use_controller="true" />

        <!-- Capa do episódio (áudio/podcast) — sobre o vídeo preto -->
        <LinearLayout
            android:id="@+id/audio_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp">

                <View
                    android:id="@+id/audio_cover_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_gradient_pink" />

                <ImageView
                    android:id="@+id/audio_cover_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@string/thumb_desc" />

                <TextView
                    android:id="@+id/audio_cover_monogram"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/tile_title"
                    android:textSize="64sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/audio_cover_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_detail_course"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/audio_cover_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="@dimen/text_card_subtitle" />
        </LinearLayout>



        <!-- Frente H — "A carregar" imediato: véu + spinner sobre o vídeo
             até ao 1º frame (o PlayerActivity esconde-o no 1º STATE_READY
             e no erro de playback). Fica ABAIXO da top_bar / barra de
             controlos (filhos posteriores) e do overlay de descanso
             (Frente D, último filho da raiz). Não é clicável: o toque
             continua a chegar ao playerView (mostrar controlos). -->
        <LinearLayout
            android:id="@+id/player_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#CC000000"
            android:clickable="false"
            android:visibility="visible">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="A carregar…"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Play/pause central (quando pausado) -->
        <TextView
            android:id="@+id/center_play_pause"
            android:layout_width="@dimen/player_center_size"
            android:layout_height="@dimen/player_center_size"
            android:layout_gravity="center"
            android:background="@drawable/player_play_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▶"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:visibility="gone" />

        <!-- Barra superior: título + ações -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/top_gradient"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/title_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/restart_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minWidth="48dp"
                    android:text="↺"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sleep_timer_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minWidth="48dp"
                    android:text="⏰"
                    android:textColor="@android:color/white"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fav_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minWidth="48dp"
                    android:text="☆"
                    android:textColor="@android:color/white"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sleep_timer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/md_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Barra de controles grande (fullscreen / TV) -->
        <LinearLayout
            android:id="@+id/custom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/player_scrim_bottom"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_play_pause_bar"
                    android:layout_width="@dimen/player_bar_btn_size"
                    android:layout_height="@dimen/player_bar_btn_size"
                    android:background="@drawable/player_bar_btn_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="❚❚"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_rest_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/player_chip_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:text="🌙 Descanso"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_chip" />

                
                <TextView
                    android:id="@+id/btn_speed_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/player_chip_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:text="1.0×"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_chip"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_exit_fullscreen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/player_chip_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⛶"
                    android:textColor="@color/md_on_surface"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bar_time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00 / 00:00"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/bar_seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:max="1000"
                    android:progressDrawable="@drawable/player_progress"
                    android:thumb="@drawable/player_seek_thumb" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hint de gesto (centro, transitório) -->
        <TextView
            android:id="@+id/seek_gesture_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC000000"
            android:elevation="8dp"
            android:paddingHorizontal="22dp"
            android:paddingVertical="10dp"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Indicador de swipe (topo, transitório) -->
        <TextView
            android:id="@+id/swipe_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="80dp"
            android:background="#CC000000"
            android:elevation="8dp"
            android:paddingHorizontal="22dp"
            android:paddingVertical="10dp"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Infos abaixo do vídeo (retrato, celular) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/info_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/md_background"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/content_margin"
            android:paddingBottom="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_lg">

            <!-- Linha de controles (retrato) — v1.0.5: DUAS linhas.
                 Numa só linha, tempo + 4 pills não cabem em 360dp
                 (o botão de tela cheia caía para fora da tela e o tempo
                 era esmagado para 0dp). Sem os botões −10s/+10s (removidos
                 no patch 1.0.5 — o pulo continua por double-tap/D-pad).
                 Linha 1: tempo. Linha 2: velocidade, CC, Descanso,
                 tela cheia — todos os ids preservados. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/info_time_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00 / 00:00"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_card_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_speed_info"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/player_chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:text="1.0×"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/text_chip"
                        android:textStyle="bold" />

                    
                    <TextView
                        android:id="@+id/btn_rest_info"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/player_chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:text="🌙 Descanso"
                        android:textColor="@color/md_on_surface"
                        android:textSize="@dimen/text_chip"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_fullscreen"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/player_chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="⛶"
                        android:textColor="@color/md_on_surface"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card "Continuar de onde parou" (áudio com posição salva) -->
            <LinearLayout
                android:id="@+id/audio_resume_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/tile_focus_border"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Continuar de onde parou"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_card_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/audio_resume_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/md_primary"
                    android:textSize="@dimen/text_card_subtitle" />
            </LinearLayout>

            <!-- Título + curso -->
            <TextView
                android:id="@+id/title_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_detail_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/course_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/md_primary"
                android:textSize="@dimen/text_detail_course" />

            <!-- Anterior / Próxima -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_prev"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:background="@drawable/chip_outline"
                    android:focusable="true"
                    android:text="← Anterior"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_button" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_next"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:background="@drawable/chip_outline"
                    android:focusable="true"
                    android:text="Próxima aula →"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_button" />
            </LinearLayout>

            <!-- Frente R4 — Materiais da aula (retrato, celular): resumo,
                 pílulas, questões e ficheiros da pasta da aula, por baixo
                 do botão "Próxima aula". Carregados em 2º plano ao abrir
                 (PlayerActivity.loadMaterials) — nunca atrasam o vídeo.
                 A secção NÃO existe no layout-television (TV): os ids são
                 lidos por findViewById (nullable), nunca pelo binding. -->
            <LinearLayout
                android:id="@+id/materials_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/materials_title"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_card_title"
                    android:textStyle="bold" />

                <!-- A carregar (skeleton subtil — não bloqueia o vídeo) -->
                <LinearLayout
                    android:id="@+id/materials_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/materials_loading"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="@dimen/text_card_subtitle" />
                </LinearLayout>

                <!-- Vazio (uma linha discreta — sem espaço gigante) -->
                <TextView
                    android:id="@+id/materials_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/materials_empty"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/text_card_subtitle"
                    android:visibility="gone" />

                <!-- Erro + tentar de novo -->
                <LinearLayout
                    android:id="@+id/materials_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/materials_error"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="@dimen/text_card_subtitle" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/materials_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/chip_outline"
                        android:text="@string/materials_retry"
                        android:textColor="@color/md_primary"
                        android:textSize="@dimen/text_button" />
                </LinearLayout>

                <!-- Conteúdo -->
                <LinearLayout
                    android:id="@+id/materials_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Resumo -->
                    <LinearLayout
                        android:id="@+id/materials_summary_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:background="@drawable/chip_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/materials_summary_title"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/text_card_subtitle"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/materials_summary_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/text_card_subtitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/materials_summary_more"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/text_card_subtitle" />
                    </LinearLayout>

                    <!-- Pílulas -->
                    <TextView
                        android:id="@+id/materials_pills_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/materials_pills_title"
                        android:textColor="@color/md_on_surface"
                        android:textSize="@dimen/text_card_subtitle"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/materials_pills_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <!-- Questões -->
                    <TextView
                        android:id="@+id/materials_questions_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/materials_questions_title"
                        android:textColor="@color/md_on_surface"
                        android:textSize="@dimen/text_card_subtitle"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/materials_questions_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <!-- Ficheiros da pasta -->
                    <TextView
                        android:id="@+id/materials_files_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/materials_files_title"
                        android:textColor="@color/md_on_surface"
                        android:textSize="@dimen/text_card_subtitle"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/materials_files_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- v1.0.5: seção "A seguir" (playlist embutida no player)
                 REMOVIDA — a playlist vive na página (DetailActivity).
                 Anterior/Próxima acima continuam (avanço de aula). -->
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom nav (retrato, celular) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/content_margin"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@drawable/nav_bar_background"
        android:elevation="@dimen/elevation_3"
        app:itemActiveIndicatorStyle="@style/NavIndicatorPill"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />
    <!-- Overlay do modo Descanso (Frente D): TELA CHEIA — último filho
         da raiz, acima de player_container, info_scroll e bottom_nav
         (elevation 16dp > elevation_3 da bottom nav). Toque no overlay
         sai do descanso; o áudio e o progresso continuam. A dica central
         é bem fraca de propósito (só para descobrir a saída); se o Elton
         quiser breu total, apagar o TextView sleep_overlay_hint. -->
    <FrameLayout
        android:id="@+id/sleep_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/sleep_overlay_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🌙 Modo descanso — toque na tela para sair"
            android:textColor="#80FFFFFF"
            android:textSize="14sp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
