<?xml version="1.0" encoding="utf-8"?>
<!-- 1.0.40 — Linha do chat da assistente: avatar (só assistente,
     identidade da Vovó Fit) + bolha. O alinhamento (esq./dir.) e o
     fundo são aplicados pelo adapter. Porte do item da Meggy 2.7.58;
     avatar maior (32dp) por legibilidade +60. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/chatAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:background="@drawable/avatar_circle"
        android:clipToOutline="true"
        android:contentDescription="@string/assistente_title"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_foreground_img" />

    <TextView
        android:id="@+id/chatBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.25"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textSize="@dimen/text_card_title" />
</LinearLayout>
