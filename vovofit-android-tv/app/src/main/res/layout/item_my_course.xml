<?xml version="1.0" encoding="utf-8"?>
<!-- 1.0.40 — Tile de curso (Meus Cursos): capa 16:9 no topo + nome +
     meta "N aulas · Em curso Z%" + barra de progresso (só com aula
     em curso). Porte do item da Meggy 2.7.58; sem monograma — a
     cadeia de capas da Vovó cai sempre numa capa de drive. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/tile_bg"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/myCourseThumb"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:contentDescription="@string/thumb_desc"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/myCourseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingHorizontal="@dimen/spacing_md"
            android:textColor="@color/md_on_surface"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/myCourseMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="@dimen/spacing_md"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="@dimen/text_card_subtitle" />

        <ProgressBar
            android:id="@+id/myCourseProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_md"
            android:max="100"
            android:progressDrawable="@drawable/progress_horizontal"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
