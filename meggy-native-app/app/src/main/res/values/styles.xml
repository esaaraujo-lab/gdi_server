<?xml version="1.0" encoding="utf-8"?>
<!-- v2.7.6 — Estilos do redesign. -->
<resources>
    <!-- Indicador ativo da bottom nav (M3): pílula rosa a 12%. -->
    <style name="NavIndicatorPill" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:background">@drawable/nav_indicator_pill</item>
    </style>

    <!-- 2.7.41 — botão primário unificado (§5.2 da auditoria): o desenho
         que heroPlay/featuredContinue/ctaContinue/btnLogout já repetiam
         à mão (pílula rosa sólida + texto md_on_primary 8,20:1 +
         sentence case + Label Large 14sp bold). minHeight 48dp no estilo
         (o layout usa wrap_content); a migração dos botões existentes
         para este estilo é P2 — os botões NOVOS da 2.7.41 usam-no. -->
    <style name="Widget.Meggy.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:background">@drawable/btn_primary_pill</item>
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 2.7.41 — botão secundário unificado (outline): idem, com
         chip_outline e texto md_on_surface (o desenho do btn_prev). -->
    <style name="Widget.Meggy.Button.Outline" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:background">@drawable/chip_outline</item>
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
