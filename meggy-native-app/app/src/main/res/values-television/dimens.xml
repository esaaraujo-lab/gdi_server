<!--
  v2.7.6 — Tipo e geometria para TV (android-tv-design skill).
  Qualificador values-television: aplicado em aparelhos TV (Leanback).
  Valores reais da TV (baseline aprovada pelo Elton na 32"): titulo
  30sp, secao 18sp, card 13sp, meta 10.5sp, corpo 13sp. Os "pisos"
  da skill (metadados >=24sp, secao 28sp, hero >=48sp) NAO sao
  cumpridos — NAO subir os tipos sem decisao do Elton (na 32"
  renderizariam ~60% maiores que o aspeto aprovado).
  Ronda 7 Frente B: estes valores sao a baseline de escala 1.0 do
  TvAutoFit — o runtime deriva tudo do viewport medido.
  Margens de overscan: 56dp laterais (mínimo 48dp), 40dp topo/fundo
  neste arquivo (o detalhe TV partilha estes dimens — a home aplica
  >=48dp em runtime, ver TvAutoFit.topMarginPx()).
  Patch TV 2.7.7/2.1.6/1.0.5 (bug layout gigante na TV): cards do rail
  360dp -> 200dp (baseline 2.7.5), drive 280dp -> 156dp, thumb do
  destaque 520x260 -> 320x180 (16:9), hero 360dp -> 340dp (o bloco de
  texto tem ~320dp de altura com os tipos TV; 320dp não deixa folga).
  Gap total entre cartões na TV: 16dp (marginEnd 8dp + decoração 8dp
  do RailGutterDecoration) — ver TV_LAYOUT_FIX_2.7.7.md.
  Ronda 7 Frente B: a 1.0 o gap mantem-se 16dp; acima disso cresce
  para 10% da largura do card (TvAutoFit), para o foco 1.10x caber
  no passo sem sobrepor os vizinhos (hoje 220dp > 216dp).
  v2.7.9 — tamanhos 2.7.5 com o visual novo (Elton 11:13/11:15):
  título/seção/card/meta/hero/drive de volta às medidas da 2.7.5;
  margens de overscan (56/40dp) mantidas — sem elas o texto é
  cortado na borda (foto do Elton). Texto: título 30sp, seção
  18sp, card 13sp, meta 10.5sp, corpo 13sp, botão 15sp.
-->
<resources>
    <!-- ── Tipo (TV) ── -->
    <dimen name="tv_title_lg">30sp</dimen>
    <dimen name="tv_title_md">22sp</dimen>
    <!-- 2.7.56 — escala tipográfica da proposta Plex (aprovada
         2026-11-25): detalhe 30 / seção 20 / cartão 15 / metadados 13. -->
    <dimen name="tv_section_title">28sp</dimen>
    <dimen name="tv_card_title">15sp</dimen>
    <dimen name="tv_card_meta">13sp</dimen>
    <dimen name="tv_body">13sp</dimen>
    <dimen name="tv_body_lg">14sp</dimen>
    <dimen name="tv_chip_text">12sp</dimen>
    <dimen name="tv_button_text">15sp</dimen>
    <dimen name="tv_time_text">24sp</dimen>

    <!-- ── Overscan / margens (TV) ── -->
    <dimen name="tv_margin_side">56dp</dimen>
    <!-- 2.7.56 — topo/fundo alinhados ao piso de overscan de 48dp
         (a home já aplicava >=48dp em runtime via TvAutoFit; o
         detalhe usava estes dimens directamente e ficava a 40dp). -->
    <dimen name="tv_margin_top">48dp</dimen>
    <dimen name="tv_margin_bottom">48dp</dimen>
    <dimen name="tv_section_spacing">26dp</dimen>
    <dimen name="tv_rail_spacing">12dp</dimen>

    <!-- ── Cards / hero (TV) ── -->
    <dimen name="tv_hero_height">320dp</dimen>
    <dimen name="tv_card_width">200dp</dimen>
    <dimen name="tv_card_image_height">112dp</dimen>
    <dimen name="tv_drive_card_width">150dp</dimen>
    <dimen name="tv_drive_card_height">210dp</dimen>
    <dimen name="tv_detail_hero_width">800dp</dimen>
    <dimen name="tv_play_fab_size">80dp</dimen>
    <!-- v2.7.10 — disco de play da TV: 120dp era o circulo rosa gigante
         da foto (11:48); 96dp e o disco modesto sobre o video.
         2.7.55 — 80dp: o Elton achou o hero do detalhe enorme no
         teste da TV; este dimen é o que dimensiona o heroPlayFab
         do detalhe TV (o tv_play_fab_size nunca foi referenciado). -->
    <dimen name="play_fab_size">80dp</dimen>
    <!-- Frente R3A (Plyr) — botao play/pausa da barra SO-ICONE na TV:
         48dp, glifo 24sp; disco central (overlay de pausa) 56dp, glifo 24sp.
         player_fab_size (Frente E, 72dp) sai. -->
    <dimen name="player_bar_btn_size">48dp</dimen>
    <dimen name="player_center_size">56dp</dimen>
    <dimen name="tv_rail_gap">8dp</dimen>
    <dimen name="tv_drive_tile_height">112dp</dimen>
    <dimen name="tv_hero_text_padding_side">32dp</dimen>
    <dimen name="tv_focus_ring_width">4dp</dimen>
    <dimen name="tv_focus_elevation">8dp</dimen>
    <dimen name="tv_control_button_size">96dp</dimen>
    <dimen name="tv_control_icon_size">56dp</dimen>
    <dimen name="tv_seek_button_size">72dp</dimen>
    <dimen name="tv_featured_card_height">180dp</dimen>
    <dimen name="tv_featured_thumb_width">320dp</dimen>

    <!-- ── Foco (TV) ── -->
    <!-- Ronda 7 Frente B: focus_scale_tv documenta a constante SCALE_TV
         = 1.10f do FocusAnimator (o codigo usa a constante); o anel e
         3dp fixos no codigo, nao os 4dp deste dimen (tv_focus_ring_width
         nao e usado) — nao mudar sem decisao visual. -->
    <dimen name="focus_ring_width_tv">4dp</dimen>
    <dimen name="focus_scale_tv">1.10</dimen>
</resources>
