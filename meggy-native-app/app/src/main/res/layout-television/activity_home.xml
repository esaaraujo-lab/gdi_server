<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.7.6 — Home TV (layout-television, conceito home TV + TV continuar).
  Margens de overscan 56dp laterais / 40dp topo e fundo no XML (a home
  aplica >=48dp em runtime — TvAutoFit). Tipos TV reais (título 30sp,
  seção 18sp, card 13sp, meta 10.5sp). Sem bottom nav na TV (gone no layout e no
  código). Foco inicial: botão "Continuar" do destaque.
  Mesmos ids do layout de celular (ViewBinding único).
  v2.7.10 — destaque focavel (anel 3dp + 1.10x) + estrela sem armadilha de foco (Elton 11:47).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <!-- 2.7.56 — estrutura Plex: o conteúdo tem largura FIXA (ecrã
         menos os 56dp da barra em repouso, via layout_marginStart) e
         NUNCA é re-medido; a barra lateral (último filho, por cima)
         expande deslizando sobre ele — a Home traduz o conteúdo
         (translationX) ao ritmo da expansão, sem refluir. As margens
         de overscan vivem aqui (a home aplica >=48dp em runtime —
         TvAutoFit, sobre esta vista). Sem menu (Ajustes), a Home
         põe a margem a 0 e o conteúdo ocupa tudo. -->
    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="56dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/tv_margin_side"
        android:paddingTop="@dimen/tv_margin_top"
        android:paddingBottom="@dimen/tv_margin_bottom">

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false">

            <!-- Topo: logo + sair (2.7.48: com o menu ligado esta
                 linha esconde-se — o menu cobre a navegação e o Sair). -->
            <LinearLayout
                android:id="@+id/homeTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/topLogo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_launcher_foreground_img" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/topTitle"
                    android:text="@string/app_name"
                    android:textColor="@color/md_primary"
                    android:textSize="@dimen/tv_title_md"
                    android:textStyle="bold" />

                <!-- 2.7.41 (P0-2/P0-3) — navegação da TV no cabeçalho: na
                     TV a bottom nav é gone e só o Início tinha caminho
                     (Buscar só existia no detalhe; Minha lista e
                     Ajustes não tinham nenhum). Atalhos focáveis com
                     anel (FocusAnimator, ver HomeActivity) e cadeia
                     nextFocus* para o D-pad. -->
                <ImageView
                    android:id="@+id/tvNavSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/focus_ring_transparent"
                    android:clickable="true"
                    android:contentDescription="@string/home_search"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusRight="@id/tvNavMylist"
                    android:nextFocusDown="@id/railContinue"
                    android:padding="12dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/md_on_surface" />

                <ImageView
                    android:id="@+id/tvNavMylist"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/focus_ring_transparent"
                    android:clickable="true"
                    android:contentDescription="@string/mylist_title"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/tvNavSearch"
                    android:nextFocusRight="@id/tvNavSettings"
                    android:nextFocusDown="@id/railContinue"
                    android:padding="12dp"
                    android:src="@drawable/ic_nav_bookmark"
                    app:tint="@color/md_on_surface" />

                <ImageView
                    android:id="@+id/tvNavSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/focus_ring_transparent"
                    android:clickable="true"
                    android:contentDescription="@string/settings_title"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/tvNavMylist"
                    android:nextFocusRight="@id/topSair"
                    android:nextFocusDown="@id/railContinue"
                    android:padding="12dp"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="@color/md_on_surface" />

                <TextView
                    android:id="@+id/topSair"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/focus_ring_transparent"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/tvNavSettings"
                    android:nextFocusDown="@id/railContinue"
                    android:padding="@dimen/spacing_sm"
                    android:text="@string/home_logout"
                    android:textColor="@color/md_primary"
                    android:textSize="@dimen/tv_body" />
            </LinearLayout>

            <!-- 2.7.58 — HERO AMBIENTE (decisão 19:24): o topo
                 mostra a arte do item focado em grande (backdrop +
                 título + meta + progresso + selo Continuar). Não é
                 focável: o OK faz-se no cartão focado. Sem item/sem
                 arte fica gone (fundo limpo) — ver
                 HomeActivity.updateAmbientHero. -->
            <FrameLayout
                android:id="@+id/ambientHero"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ambientImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_gradient" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:id="@+id/ambientTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:shadowColor="#000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:textColor="@android:color/white"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ambientMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/md_primary"
                        android:textSize="17sp" />

                    <ProgressBar
                        android:id="@+id/ambientProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="320dp"
                        android:layout_height="6dp"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:max="100"
                        android:progressDrawable="@drawable/progress_horizontal"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:background="@drawable/btn_primary_pill"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="@string/ambient_continue"
                        android:textColor="@color/md_on_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- 2.7.41 (P1-13) — estados de carregamento/erro da home
                 (ver layout de celular; mesmos ids, tipos de TV). -->
            <LinearLayout
                android:id="@+id/homeLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@drawable/skeleton_block" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/skeleton_block" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/skeleton_block" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/home_loading"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/home_error"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/homeRetry"
                    style="@style/Widget.Meggy.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/browse_retry" />
            </LinearLayout>

            <!-- Hero — 2.7.56: GONE na TV (B2 da proposta Plex:
                 home por fileiras, sem hero fixo a competir; o
                 cartão largo do Continuar é o 1.º da fileira). A
                 estrutura fica (ViewBinding único; o celular usa a
                 sua variante) mas nunca é visível nem focável aqui,
                 e o setupHero da TV já não cria o rotador. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_hero_height"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_0"
                app:cardBackgroundColor="@color/tile_bg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/heroBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/hero_dark_gradient" />

                    <!-- Foto real do destaque (Coil) + scrim escuro para o texto -->
                    <ImageView
                        android:id="@+id/heroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@string/thumb_desc" />

                    <View
                        android:id="@+id/heroScrim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/tile_overlay_bottom"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/tv_hero_text_padding_side"
                        android:paddingVertical="@dimen/tv_section_spacing">

                        <TextView
                            android:id="@+id/heroBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/chip_badge"
                            android:paddingHorizontal="@dimen/spacing_lg"
                            android:paddingVertical="@dimen/spacing_sm"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/tv_chip_text"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/tv_title_lg"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/tv_body_lg" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/heroPlay"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="@dimen/spacing_lg"
                            android:background="@drawable/btn_primary_pill"
                            android:focusable="true"
                            android:paddingHorizontal="@dimen/spacing_2xl"
                            android:text="@string/explore_cta"
                            android:textColor="@color/md_on_primary"
                            android:textSize="@dimen/tv_button_text"
                            android:textStyle="bold" />

                    </LinearLayout>

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2.7.52 — HERO IMERSIVO (conceito tv-home-nova): o
                 destaque "Continuar" passa a hero em tela cheia:
                 thumbnail full-bleed, scrim escuro, título = tema da
                 aula (40sp), curso, progresso e o botão "Continuar
                 Assistindo" (a MESMA continueWatching de sempre).
                 O rótulo da seção some na TV (o hero fala por si);
                 continua a ser o 1.º filho porque o applyTvAutoFit
                 lhe ajusta o tipo. Mesmos ids (ViewBinding único). -->
            <LinearLayout
                android:id="@+id/featuredSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_from_where"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/featured_card"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clickable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/elevation_0"
                    app:cardBackgroundColor="@color/tile_bg"
                    app:strokeWidth="0dp"
                    app:strokeColor="@color/tile_focus_ring">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:id="@+id/featuredBg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/hero_dark_gradient" />

                            <ImageView
                                android:id="@+id/featuredThumb"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"
                                android:contentDescription="@string/thumb_desc" />

                            <TextView
                                android:id="@+id/featuredFallbackIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="@color/tile_title"
                                android:textSize="56sp"
                                android:textStyle="bold"
                                android:alpha="0.95" />
                        </FrameLayout>

                        <!-- Scrim escuro p/ legibilidade do texto
                             sobre a foto (contraste ≥ 4.5:1). -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/tile_overlay_bottom" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:orientation="vertical"
                            android:paddingHorizontal="32dp"
                            android:paddingTop="24dp"
                            android:paddingBottom="28dp">

                            <TextView
                                android:id="@+id/featuredTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/md_on_surface"
                                android:textSize="40sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/featuredSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="18sp" />

                            <ProgressBar
                                android:id="@+id/featuredProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="520dp"
                                android:layout_height="8dp"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:max="100"
                                android:progressDrawable="@drawable/progress_horizontal" />

                            <TextView
                                android:id="@+id/featuredProgressText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:textColor="@color/md_primary"
                                android:textSize="16sp" />

                            <!-- Na TV o texto de posição some: o
                                 progresso já diz "% • Xmin restantes"
                                 (featuredProgressText). A vista fica
                                 (binding) mas gone. -->
                            <TextView
                                android:id="@+id/featuredTimeText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/tv_body"
                                android:visibility="gone" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/featuredContinue"
                                android:layout_width="wrap_content"
                                android:layout_height="56dp"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:background="@drawable/btn_primary_pill"
                                android:focusable="true"
                                android:paddingHorizontal="@dimen/spacing_2xl"
                                android:text="@string/cta_continue"
                                android:textColor="@color/md_on_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Continue assistindo -->
            <TextView
                android:id="@+id/labelContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:text="@string/continue_watching"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/tv_section_title"
                android:textStyle="bold" />

            <!-- R15C (ronda 15, frente C): halo de foco TV — 16dp laterais / 12dp verticais + sem corte (clipChildren=false). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/railContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_rail_spacing"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:clipChildren="false"
                android:overScrollMode="never" />

            <!-- 2.7.48 — "Destaques" (conceito 3): os mesmos ids do
                 celular; o layout de item é o do celular (a largura
                 do cartão não é escalada pelo TvAutoFit — ver SPEC). -->
            <TextView
                android:id="@+id/labelDestaques"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:text="@string/home_highlights"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/tv_section_title"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listDestaques"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_rail_spacing"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <!-- 2.7.48 — "Pastas recentes" (conceito 1): mesmos ids do
                 celular, sem "Ver tudo" na TV. -->
            <TextView
                android:id="@+id/labelRecentFolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:text="@string/home_recent_folders"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/tv_section_title"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/railRecentFolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_rail_spacing"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <!-- 2.7.48 — painel "Seu Progresso" (conceito 3): horas da
                 semana + sequência de dias, LIDOS DO SERVIDOR (a seção
                 some sem o cache do import — nunca número local). -->
            <LinearLayout
                android:id="@+id/progressPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:background="@drawable/card_surface_rounded"
                android:orientation="vertical"
                android:padding="@dimen/tv_rail_spacing"
                android:visibility="gone">

                <TextView
                    android:id="@+id/progressTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_progress_title"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/progressWeekHours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/tv_title_md"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/progressWeekLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_progress_week"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/tv_body" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/progressStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/tv_title_md"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/progressStreakLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_progress_streak"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/tv_body" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Explorar drives -->
            <TextView
                android:id="@+id/labelDrives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:text="@string/explore_drives"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/tv_section_title"
                android:textStyle="bold" />

            <!-- R15C (ronda 15, frente C): halo de foco TV — 16dp laterais / 12dp verticais + sem corte (clipChildren=false). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/railDrives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_rail_spacing"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:clipChildren="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/footerVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:gravity="center"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="@dimen/tv_body" />
        </LinearLayout>
    </ScrollView>

    <!-- Sem bottom nav na TV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:menu="@menu/bottom_nav_menu" />
    </LinearLayout>

    <!-- 2.7.56 — barra lateral estilo Plex POR CIMA do conteúdo
         (último filho do FrameLayout): repouso 56dp só ícones;
         expande a 240dp ao foco e desliza sobre o conteúdo sem o
         refluir. A largura/visibilidade resolvem-se em código
         (SideMenuView: comportamento ao foco; HomeActivity:
         interruptor dos Ajustes). -->
    <com.meggy.app.ui.home.SideMenuView
        android:id="@+id/tvSideMenu"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
