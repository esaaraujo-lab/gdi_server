<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.7.6 — Home TV (layout-television, conceito home TV + TV continuar).
  Margens de overscan 56dp laterais / 40dp topo e fundo no XML (a home
  aplica >=48dp em runtime — TvAutoFit). Tipos TV reais (título 30sp,
  seção 18sp, card 13sp, meta 10.5sp). Sem bottom nav na TV (gone no layout e no
  código). Foco inicial: botão "Continuar" do destaque.
  Mesmos ids do layout de celular (ViewBinding único).
  v2.7.10 — destaque focavel (anel 3dp + 1.10x) + estrela sem armadilha de foco (Elton 11:47).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/tv_margin_side"
    android:paddingTop="@dimen/tv_margin_top"
    android:paddingBottom="@dimen/tv_margin_bottom">

    <!-- 2.7.48 — menu lateral (conceito 3/4; decisão 21:37: só na
         TV). A largura inicial é a expandida (240dp); o estado
         recolhido/expandido e a visibilidade (interruptor nos
         Ajustes) resolvem-se em código (SideMenuView/HomeActivity).
         Sem menu, o conteúdo ocupa a largura toda. -->
    <com.meggy.app.ui.home.SideMenuView
        android:id="@+id/tvSideMenu"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false">

            <!-- Topo: logo + sair (2.7.48: com o menu ligado esta
                 linha esconde-se — o menu cobre a navegação e o Sair). -->
            <LinearLayout
                android:id="@+id/homeTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/topLogo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_launcher_foreground_img" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/topTitle"
                    android:text="@string/app_name"
                    android:textColor="@color/md_primary"
                    android:textSize="@dimen/tv_title_md"
                    android:textStyle="bold" />

                <!-- 2.7.41 (P0-2/P0-3) — navegação da TV no cabeçalho: na
                     TV a bottom nav é gone e só o Início tinha caminho
                     (Buscar só existia no detalhe; Minha lista e
                     Ajustes não tinham nenhum). Atalhos focáveis com
                     anel (FocusAnimator, ver HomeActivity) e cadeia
                     nextFocus* para o D-pad. -->
                <ImageView
                    android:id="@+id/tvNavSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/focus_ring_transparent"
                    android:clickable="true"
                    android:contentDescription="@string/home_search"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusRight="@id/tvNavMylist"
                    android:nextFocusDown="@id/heroPlay"
                    android:padding="12dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/md_on_surface" />

                <ImageView
                    android:id="@+id/tvNavMylist"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/focus_ring_transparent"
                    android:clickable="true"
                    android:contentDescription="@string/mylist_title"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/tvNavSearch"
                    android:nextFocusRight="@id/tvNavSettings"
                    android:nextFocusDown="@id/heroPlay"
                    android:padding="12dp"
                    android:src="@drawable/ic_nav_bookmark"
                    app:tint="@color/md_on_surface" />

                <ImageView
                    android:id="@+id/tvNavSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/focus_ring_transparent"
                    android:clickable="true"
                    android:contentDescription="@string/settings_title"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/tvNavMylist"
                    android:nextFocusRight="@id/topSair"
                    android:nextFocusDown="@id/heroPlay"
                    android:padding="12dp"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="@color/md_on_surface" />

                <TextView
                    android:id="@+id/topSair"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/focus_ring_transparent"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/tvNavSettings"
                    android:nextFocusDown="@id/heroPlay"
                    android:padding="@dimen/spacing_sm"
                    android:text="@string/home_logout"
                    android:textColor="@color/md_primary"
                    android:textSize="@dimen/tv_body" />
            </LinearLayout>

            <!-- 2.7.41 (P1-13) — estados de carregamento/erro da home
                 (ver layout de celular; mesmos ids, tipos de TV). -->
            <LinearLayout
                android:id="@+id/homeLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@drawable/skeleton_block" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/skeleton_block" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/skeleton_block" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/home_loading"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/home_error"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/homeRetry"
                    style="@style/Widget.Meggy.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/browse_retry" />
            </LinearLayout>

            <!-- Hero -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tv_hero_height"
                android:layout_marginTop="@dimen/tv_section_spacing"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_0"
                app:cardBackgroundColor="@color/tile_bg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/heroBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/hero_dark_gradient" />

                    <!-- Foto real do destaque (Coil) + scrim escuro para o texto -->
                    <ImageView
                        android:id="@+id/heroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@string/thumb_desc" />

                    <View
                        android:id="@+id/heroScrim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/tile_overlay_bottom"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/tv_hero_text_padding_side"
                        android:paddingVertical="@dimen/tv_section_spacing">

                        <TextView
                            android:id="@+id/heroBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/chip_badge"
                            android:paddingHorizontal="@dimen/spacing_lg"
                            android:paddingVertical="@dimen/spacing_sm"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/tv_chip_text"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/tv_title_lg"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/tv_body_lg" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/heroPlay"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="@dimen/spacing_lg"
                            android:background="@drawable/btn_primary_pill"
                            android:focusable="true"
                            android:paddingHorizontal="@dimen/spacing_2xl"
                            android:text="@string/explore_cta"
                            android:textColor="@color/md_on_primary"
                            android:textSize="@dimen/tv_button_text"
                            android:textStyle="bold" />

                    </LinearLayout>

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "Continuar de onde parou" — destaque (TV) -->
            <LinearLayout
                android:id="@+id/featuredSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_from_where"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/featured_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clickable="true"
                    android:descendantFocusability="blocksDescendants"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/elevation_0"
                    app:cardBackgroundColor="@color/tile_bg"
                    app:strokeWidth="0dp"
                    app:strokeColor="@color/tile_focus_ring">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/tv_rail_spacing">

                        <FrameLayout
                            android:layout_width="@dimen/tv_featured_thumb_width"
                            android:layout_height="@dimen/tv_featured_card_height">

                            <View
                                android:id="@+id/featuredBg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/hero_dark_gradient" />

                            <ImageView
                                android:id="@+id/featuredThumb"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"
                                android:contentDescription="@string/thumb_desc" />

                            <TextView
                                android:id="@+id/featuredFallbackIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="@color/tile_title"
                                android:textSize="56sp"
                                android:textStyle="bold"
                                android:alpha="0.95" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/tv_rail_spacing"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/featuredTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/md_on_surface"
                                android:textSize="@dimen/tv_title_md"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/featuredSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/tv_body" />

                            <ProgressBar
                                android:id="@+id/featuredProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:max="100"
                                android:progressDrawable="@drawable/progress_horizontal" />

                            <TextView
                                android:id="@+id/featuredProgressText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:textColor="@color/md_primary"
                                android:textSize="@dimen/tv_body" />

                            <TextView
                                android:id="@+id/featuredTimeText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/tv_body" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/featuredContinue"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:background="@drawable/btn_primary_pill"
                                android:focusable="true"
                                android:paddingHorizontal="@dimen/spacing_2xl"
                                android:text="@string/cta_continue"
                                android:textColor="@color/md_on_primary"
                                android:textSize="@dimen/tv_button_text"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Continue assistindo -->
            <TextView
                android:id="@+id/labelContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:text="@string/continue_watching"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/tv_section_title"
                android:textStyle="bold" />

            <!-- R15C (ronda 15, frente C): halo de foco TV — 16dp laterais / 12dp verticais + sem corte (clipChildren=false). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/railContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_rail_spacing"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:clipChildren="false"
                android:overScrollMode="never" />

            <!-- 2.7.48 — "Destaques" (conceito 3): os mesmos ids do
                 celular; o layout de item é o do celular (a largura
                 do cartão não é escalada pelo TvAutoFit — ver SPEC). -->
            <TextView
                android:id="@+id/labelDestaques"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:text="@string/home_highlights"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/tv_section_title"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listDestaques"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_rail_spacing"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <!-- 2.7.48 — "Pastas recentes" (conceito 1): mesmos ids do
                 celular, sem "Ver tudo" na TV. -->
            <TextView
                android:id="@+id/labelRecentFolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:text="@string/home_recent_folders"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/tv_section_title"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/railRecentFolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_rail_spacing"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <!-- 2.7.48 — painel "Seu Progresso" (conceito 3): horas da
                 semana + sequência de dias, LIDOS DO SERVIDOR (a seção
                 some sem o cache do import — nunca número local). -->
            <LinearLayout
                android:id="@+id/progressPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:background="@drawable/card_surface_rounded"
                android:orientation="vertical"
                android:padding="@dimen/tv_rail_spacing"
                android:visibility="gone">

                <TextView
                    android:id="@+id/progressTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_progress_title"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/progressWeekHours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/tv_title_md"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/progressWeekLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_progress_week"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/tv_body" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/progressStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/tv_title_md"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/progressStreakLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_progress_streak"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/tv_body" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Explorar drives -->
            <TextView
                android:id="@+id/labelDrives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:text="@string/explore_drives"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/tv_section_title"
                android:textStyle="bold" />

            <!-- R15C (ronda 15, frente C): halo de foco TV — 16dp laterais / 12dp verticais + sem corte (clipChildren=false). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/railDrives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_rail_spacing"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:clipChildren="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/footerVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:gravity="center"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="@dimen/tv_body" />
        </LinearLayout>
    </ScrollView>

    <!-- Sem bottom nav na TV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:menu="@menu/bottom_nav_menu" />
    </LinearLayout>
</LinearLayout>
