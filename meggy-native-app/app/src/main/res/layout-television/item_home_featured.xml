<?xml version="1.0" encoding="utf-8"?>
<!-- 2.7.52 — "Destaques" na TV (conceito tv-home-nova): cartão GRANDE
     340dp, capa 16:9 em cima e título/subtítulo em baixo — o mesmo
     formato visual da fileira "Continue assistindo". MESMOS ids da
     variante do celular (ViewBinding único; o adapter não muda).
     Foco: anel branco 4dp pelo fundo com estado (featured_card_bg_tv)
     + escala 1,05 pelo FocusAnimator.attach no adapter (só TV).
     O celular mantém o cartão horizontal de 320dp (layout/). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/featured_card_bg_tv"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="191dp">

        <View
            android:id="@+id/homeFeaturedBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/homeFeaturedThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/homeFeaturedMonogram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/md_on_primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeFeaturedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/chip_badge"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="@color/md_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/homeFeaturedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/md_on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/homeFeaturedSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/md_on_surface_variant"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
