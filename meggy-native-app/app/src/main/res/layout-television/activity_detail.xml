<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.7.6 — Detalhe · TV (conceito TV detalhe): 2 colunas — vídeo à
  esquerda (16:9, play rosa, tempo + barra) e à direita título grande,
  curso em rosa, chips, botão "Continuar assistindo" EM FOCO, abas
  Resumo/Questões/Flashcards, texto do resumo e rodapé
  "Você está em X% — Ymin assistidos". Header com logo + busca + avatar.
  A aba Aulas mostra a grade 2×2 (conceito TV escolher-aulas).
  Mesmos ids do layout de celular (ViewBinding único).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/tv_margin_side"
    android:paddingTop="@dimen/tv_margin_top"
    android:paddingBottom="@dimen/tv_margin_bottom">

    <!-- Toolbar (oculta na TV; mantida para o binding) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:titleTextColor="@color/md_on_surface" />

    <!-- Header TV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/md_on_surface"
            android:textSize="@dimen/tv_title_md"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/headerSearch"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:clickable="true"
            android:contentDescription="Buscar"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_search"
            android:tint="@color/md_on_surface" />

        <TextView
            android:id="@+id/headerAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/spacing_lg"
            android:background="@drawable/btn_play_circle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textColor="@color/md_on_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Linha hero + info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:orientation="horizontal">

                <!-- Hero -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="360dp"
                    android:layout_weight="52"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/elevation_0"
                    app:cardBackgroundColor="@color/tile_bg">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <View
                            android:id="@+id/heroBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/card_gradient_pink" />

                        <ImageView
                            android:id="@+id/heroImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="@string/thumb_desc" />

                        <TextView
                            android:id="@+id/heroMonogram"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/tile_title"
                            android:textSize="72sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroPlayFab"
                            android:layout_width="@dimen/tv_play_fab_size"
                            android:layout_height="@dimen/tv_play_fab_size"
                            android:layout_gravity="center"
                            android:background="@drawable/btn_play_circle"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="▶"
                            android:textColor="@color/md_on_primary"
                            android:textSize="48sp" />

                        <TextView
                            android:id="@+id/heroFav"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="@dimen/spacing_lg"
                            android:background="@drawable/badge_resume"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="@dimen/spacing_lg"
                            android:paddingVertical="@dimen/spacing_sm"
                            android:text="☆  Salvar"
                            android:textColor="@color/tile_title"
                            android:textSize="@dimen/tv_chip_text" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/spacing_lg"
                            android:paddingBottom="@dimen/spacing_md">

                            <TextView
                                android:id="@+id/heroTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/tile_title"
                                android:textSize="@dimen/tv_time_text"
                                android:textStyle="bold" />

                            <ProgressBar
                                android:id="@+id/heroProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:layout_marginTop="4dp"
                                android:max="100"
                                android:progressDrawable="@drawable/progress_horizontal" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/tv_section_spacing"
                    android:layout_weight="48"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textColor="@color/md_on_surface"
                        android:textSize="@dimen/tv_title_lg"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/heroSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/md_primary"
                        android:textSize="@dimen/tv_body_lg" />

                    <LinearLayout
                        android:id="@+id/chipsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipCount"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:background="@drawable/chip_outline"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/spacing_lg"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/tv_chip_text" />

                        <TextView
                            android:id="@+id/chipFolders"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:background="@drawable/chip_outline"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/spacing_lg"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/tv_chip_text" />

                        <TextView
                            android:id="@+id/chipProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:background="@drawable/chip_outline"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/spacing_lg"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/tv_chip_text" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/ctaContinue"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:background="@drawable/btn_primary_pill"
                        android:focusable="true"
                        android:text="@string/cta_continue"
                        android:textColor="@color/md_on_primary"
                        android:textSize="@dimen/tv_button_text"
                        android:textStyle="bold" />

                    <!-- Abas -->
                    <LinearLayout
                        android:id="@+id/tabsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tv_section_spacing"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/tabResumo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_md">

                            <TextView
                                android:id="@+id/tabResumoLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tab_summary"
                                android:textColor="@color/md_primary"
                                android:textSize="@dimen/tv_body"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/tabIndicatorResumo"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="6dp"
                                android:background="@color/md_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tabAulas"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_md">

                            <TextView
                                android:id="@+id/tabAulasLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tab_lessons"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/tv_body" />

                            <View
                                android:id="@+id/tabIndicatorAulas"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="6dp"
                                android:background="@android:color/transparent" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tabQuestoes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_md">

                            <TextView
                                android:id="@+id/tabQuestoesLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tab_questions"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/tv_body" />

                            <View
                                android:id="@+id/tabIndicatorQuestoes"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="6dp"
                                android:background="@android:color/transparent" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tabFlashcards"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_md">

                            <TextView
                                android:id="@+id/tabFlashcardsLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tab_flashcards"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/tv_body" />

                            <View
                                android:id="@+id/tabIndicatorFlashcards"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="6dp"
                                android:background="@android:color/transparent" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Painel: Resumo (na coluna direita) -->
                    <LinearLayout
                        android:id="@+id/panelResumo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/resumoState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/tv_chip_text" />

                        <TextView
                            android:id="@+id/resumoText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/tv_body" />

                        <TextView
                            android:id="@+id/detailFooter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xl"
                            android:gravity="end"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/tv_body" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Painel: Aulas (grade 2×2, largura total) -->
            <LinearLayout
                android:id="@+id/panelAulas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone"
                    app:boxBackgroundColor="@color/md_surface_container"
                    app:boxCornerRadiusTopStart="28dp"
                    app:boxCornerRadiusTopEnd="28dp"
                    app:boxCornerRadiusBottomStart="28dp"
                    app:boxCornerRadiusBottomEnd="28dp"
                    app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/lessonSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Buscar aula…"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:textColor="@color/md_on_surface"
                        android:textColorHint="@color/md_on_surface_variant"
                        android:textSize="@dimen/tv_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/labelContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:text="@string/continue_from_where"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/railContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:text="@string/tab_lessons"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <ProgressBar
                    android:id="@+id/loadingView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:gravity="center"
                    android:text="@string/browse_empty"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Painel: Questões -->
            <LinearLayout
                android:id="@+id/panelQuestoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/questoesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/no_questions"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />
            </LinearLayout>

            <!-- Painel: Flashcards -->
            <LinearLayout
                android:id="@+id/panelFlashcards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/flashcardsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/no_flashcards"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Sem bottom nav na TV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
