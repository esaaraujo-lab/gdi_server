<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.7.6 — Detalhe · TV. 2.7.52 (conceito tv-detalhe-video, regra
  TV SÓ VÍDEO): cabeçalho IMERSIVO em largura total — fundo = capa/
  thumb da aula (heroImage, a cadeia de capas de sempre), título =
  tema/pasta sobre a foto (40sp), botões "Continuar Assistindo"
  (ctaContinue, a MESMA playResumeOrFirst) e "Assistir do Início"
  (btnFromStart, só TV, a MESMA playFirstVideo), tempo + progresso
  da aula; abaixo, a linha de progresso do curso (tvCourseLine/
  tvCourseProgress) e a fileira horizontal de aulas (tvLessonsRail,
  só TV). As abas de estudo, o botão de questões e os chips de
  contagem ficam GONE neste layout e o selectTab força a aba Aulas
  na TV — no celular nada muda (layout/activity_detail.xml intacto).
  Mesmos ids do layout de celular (ViewBinding único); os ids novos
  (btnFromStart, tvLessonsLabel, tvLessonsRail) só existem aqui e o
  código lê-os por findViewById.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/tv_margin_side"
    android:paddingTop="@dimen/tv_margin_top"
    android:paddingBottom="@dimen/tv_margin_bottom">

    <!-- Toolbar (oculta na TV; mantida para o binding) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:titleTextColor="@color/md_on_surface" />

    <!-- Header TV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/md_on_surface"
            android:textSize="@dimen/tv_title_md"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/headerSearch"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:clickable="true"
            android:contentDescription="Buscar"
            android:focusable="true"
            android:background="@drawable/focus_ring_transparent"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/ctaContinue"
            android:padding="12dp"
            android:src="@drawable/ic_search"
            android:tint="@color/md_on_surface" />

        <!-- 2.7.55 — carinha da Meggy (pedido do Elton, foto da TV
             18:01): a bolinha rosa vazia passa a foto oficial da
             Meggy (a mesma do site), recortada em círculo pelo
             outline oval de @drawable/avatar_circle + clipToOutline.
             Mantém o id e os 56dp do header. -->
        <ImageView
            android:id="@+id/headerAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/spacing_lg"
            android:background="@drawable/avatar_circle"
            android:clipToOutline="true"
            android:clickable="false"
            android:contentDescription="Meggy"
            android:focusable="false"
            android:scaleType="centerCrop"
            android:src="@drawable/meggy_face" />
    </LinearLayout>

    <!-- 2.7.48 — breadcrumb da TV (conceito 4): "Início › …" com os
         segmentos do caminho actual (o segmento do drive "N:" salta).
         Só na TV; o código escreve-o por findViewById. -->
    <TextView
        android:id="@+id/tvBreadcrumb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/md_on_surface_variant"
        android:textSize="@dimen/tv_body" />

    <ScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false">

            <!-- Cabeçalho imersivo (2.7.52; altura reduzida na
                 2.7.55 — 440dp era "enorme e feio" no teste do Elton).
                 2.7.56 (B3 da proposta Plex): faixa-backdrop de 200dp
                 SÓ onde a pasta tem vídeos directos (página de aula);
                 pasta intermédia fica SEM faixa — a visibilidade é do
                 setupTvLessonsRail (id heroCard, findViewById como o
                 btnFromStart). Conteúdo aparado p/ caber nos 200dp:
                 título 1 linha 30sp, metadados 14sp, botões 56dp. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/tv_section_spacing"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_0"
                app:cardBackgroundColor="@color/tile_bg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/heroBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_gradient_pink" />

                    <ImageView
                        android:id="@+id/heroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@string/thumb_desc" />

                    <TextView
                        android:id="@+id/heroMonogram"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/tile_title"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <!-- Scrim escuro p/ legibilidade do texto
                         sobre a foto (contraste ≥ 4.5:1). -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/tile_overlay_bottom" />

                    <TextView
                        android:id="@+id/heroPlayFab"
                        android:layout_width="@dimen/play_fab_size"
                        android:layout_height="@dimen/play_fab_size"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_play_circle"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusRight="@id/ctaContinue"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="@color/md_on_primary"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/heroFav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/spacing_lg"
                        android:background="@drawable/badge_resume"
                        android:clickable="true"
                        android:focusable="true"
                        android:nextFocusLeft="@id/heroPlayFab"
                        android:nextFocusDown="@id/ctaContinue"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:text="☆  Salvar"
                        android:textColor="@color/tile_title"
                        android:textSize="@dimen/tv_chip_text" />

                    <!-- Título + botões + progresso da aula, sobre
                         a foto, em baixo. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:paddingHorizontal="28dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/md_on_surface"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/tv_body_lg" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/ctaContinue"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_weight="1"
                                android:background="@drawable/btn_cta_gradient"
                                android:focusable="true"
                                android:nextFocusLeft="@id/heroPlayFab"
                                android:nextFocusRight="@id/btnFromStart"
                                android:nextFocusDown="@id/tvLessonsRail"
                                android:text="@string/cta_continue"
                                android:textColor="@color/md_on_primary"
                                android:textSize="@dimen/tv_button_text"
                                android:textStyle="bold" />

                            <!-- 2.7.52 — "Assistir do Início" (só
                                 TV): abre a 1.ª aula da pasta pela
                                 MESMA playFirstVideo. Gone até haver
                                 vídeos directos (setupTvLessonsRail). -->
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnFromStart"
                                android:layout_width="0dp"
                                android:layout_height="56dp"
                                android:layout_marginStart="@dimen/spacing_lg"
                                android:layout_weight="1"
                                android:background="@drawable/chip_outline"
                                android:focusable="true"
                                android:nextFocusLeft="@id/ctaContinue"
                                android:nextFocusDown="@id/tvLessonsRail"
                                android:text="@string/watch_from_start"
                                android:textColor="@color/md_on_surface"
                                android:textSize="@dimen/tv_button_text"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/heroTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:textColor="@color/tile_title"
                            android:textSize="@dimen/tv_time_text"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/heroProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_horizontal" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- R22 UI + 2.7.52: linha do curso + barra larga, em
                 largura total sob o cabeçalho. A fonte são os textos
                 REAIS dos chips (syncTvCourseLine); com vídeos
                 directos na pasta, "Progresso do curso • X de Y
                 aulas concluídas • Z%" (SPEC §4). Só TV. -->
            <TextView
                android:id="@+id/tvCourseLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/tv_body_lg"
                android:textStyle="bold"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/tvCourseProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:max="100"
                android:progressDrawable="@drawable/progress_horizontal"
                android:visibility="gone" />

            <!-- Chips de contagem: GONE na TV (regra TV só vídeo —
                 nada de "tem x PDFs/pastas" no detalhe). As vistas
                 ficam na hierarquia porque o binding e o
                 syncTvCourseLine lêem os textos delas. -->
            <LinearLayout
                android:id="@+id/chipsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/chipCount"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:background="@drawable/chip_outline"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_chip_text" />

                <TextView
                    android:id="@+id/chipProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/chip_outline"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_chip_text" />
            </LinearLayout>

            <!-- R22 UI: botão de questões — GONE na TV (2.7.52, regra
                 TV só vídeo). A vista fica p/ o findViewById do
                 onCreate não mudar; o clique nunca é alcançável. -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTvQuestions"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/chip_outline"
                android:focusable="true"
                android:text="@string/tv_questions_button"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/tv_button_text"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Abas de estudo: GONE na TV (2.7.52, regra TV só
                 vídeo). A estrutura fica (binding + selectTab pintam
                 os rótulos), mas nunca é visível nem focável; o
                 selectTab força a aba Aulas na TV. -->
            <LinearLayout
                android:id="@+id/tabsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tv_section_spacing"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/tabResumo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/focus_ring_transparent"
                    android:focusableInTouchMode="true"
                    android:nextFocusRight="@id/tabAulas"
                    android:nextFocusUp="@id/ctaContinue"
                    android:nextFocusDown="@id/recycler"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tabResumoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_summary"
                        android:textColor="@color/md_primary"
                        android:textSize="@dimen/tv_body"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/tabIndicatorResumo"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/md_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabAulas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/focus_ring_transparent"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/tabResumo"
                    android:nextFocusRight="@id/tabQuestoes"
                    android:nextFocusUp="@id/ctaContinue"
                    android:nextFocusDown="@id/recycler"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tabAulasLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_lessons"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="@dimen/tv_body" />

                    <View
                        android:id="@+id/tabIndicatorAulas"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabQuestoes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/focus_ring_transparent"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/tabAulas"
                    android:nextFocusRight="@id/tabFlashcards"
                    android:nextFocusUp="@id/ctaContinue"
                    android:nextFocusDown="@id/recycler"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tabQuestoesLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_questions"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="@dimen/tv_body" />

                    <View
                        android:id="@+id/tabIndicatorQuestoes"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabFlashcards"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/focus_ring_transparent"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/tabQuestoes"
                    android:nextFocusUp="@id/ctaContinue"
                    android:nextFocusDown="@id/recycler"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tabFlashcardsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_flashcards"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="@dimen/tv_body" />

                    <View
                        android:id="@+id/tabIndicatorFlashcards"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:color/transparent" />
                </LinearLayout>
            </LinearLayout>

            <!-- Painel: Resumo (na TV nunca abre — selectTab força
                 Aulas; a estrutura fica p/ o binding). -->
            <LinearLayout
                android:id="@+id/panelResumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/resumoState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_primary"
                    android:textSize="@dimen/tv_chip_text" />

                <TextView
                    android:id="@+id/resumoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_body" />

                <TextView
                    android:id="@+id/detailFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:gravity="end"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />
            </LinearLayout>

            <!-- Painel: Aulas (grade, largura total) -->
            <LinearLayout
                android:id="@+id/panelAulas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone"
                    app:boxBackgroundColor="@color/md_surface_container"
                    app:boxCornerRadiusTopStart="28dp"
                    app:boxCornerRadiusTopEnd="28dp"
                    app:boxCornerRadiusBottomStart="28dp"
                    app:boxCornerRadiusBottomEnd="28dp"
                    app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/lessonSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Buscar aula…"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:textColor="@color/md_on_surface"
                        android:textColorHint="@color/md_on_surface_variant"
                        android:textSize="@dimen/tv_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2.7.52 — fileira horizontal de aulas (só TV,
                     conceito tv-detalhe-video): os vídeos DIRECTOS
                     da pasta em cartões grandes (RailAdapter);
                     toque = a mesma abertura de hoje (openFile).
                     Montada por setupTvLessonsRail; gone sem vídeos
                     directos. -->
                <TextView
                    android:id="@+id/tvLessonsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:text="@string/tab_lessons"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tvLessonsRail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:clipChildren="false"
                    android:overScrollMode="never"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:text="@string/continue_from_where"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- R15C (ronda 15, frente C): halo de foco TV — 16dp laterais / 12dp verticais + sem corte (clipChildren=false). -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/railContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:clipChildren="false"
                    android:overScrollMode="never"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:text="@string/tab_lessons"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/tv_section_title"
                    android:textStyle="bold" />

                <!-- R15C (ronda 15, frente C): halo de foco na grade — padding 16dp nos 4 lados + sem corte. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_rail_spacing"
                    android:clipToPadding="false"
                    android:padding="16dp"
                    android:clipChildren="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <ProgressBar
                    android:id="@+id/loadingView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tv_section_spacing"
                    android:gravity="center"
                    android:text="@string/browse_empty"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <!-- R21: retry persistente (ver layout de celular). -->
                <Button
                    android:id="@+id/retryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="Tentar de novo"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Painel: Questões (na TV nunca abre — ver panelResumo) -->
            <LinearLayout
                android:id="@+id/panelQuestoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/questoesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/no_questions"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/questoesGenerate"
                    style="@style/Widget.Meggy.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/materials_generate_questions"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Painel: Flashcards (na TV nunca abre — ver panelResumo) -->
            <LinearLayout
                android:id="@+id/panelFlashcards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/flashcardsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/no_flashcards"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/tv_body" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/flashcardsGenerate"
                    style="@style/Widget.Meggy.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/materials_generate_flashcards"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 2.7.48 — dicas do controle remoto (conceito 4): SÓ as que
         funcionam (A = seleccionar/entrar, B = voltar). As dicas Y/X/
         Menu não entram — não há handlers p/ elas (ver SPEC). -->
    <TextView
        android:id="@+id/tvRemoteHints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center"
        android:text="@string/tv_remote_hints"
        android:textColor="@color/md_on_surface_variant"
        android:textSize="@dimen/tv_body" />

    <!-- Sem bottom nav na TV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
