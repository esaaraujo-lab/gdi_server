<?xml version="1.0" encoding="utf-8"?>
<!--
  Frente C (ronda APK) — altura FIXA do card (@dimen/tv_drive_card_height,
  210dp). Antes wrap_content: a altura variava com o nome (1 vs 2 linhas)
  e, na Meggy, com a meta (GONE sem tagline).
  Conteudo ancorado em baixo (poster 210dp, texto sobre o scrim) +
  drive_name minLines=2 (a meta fica sempre a mesma altura).
  v2.7.11 — Card de drive (home "Explorar drives", conceito home).
  Card ESCURO + quadrado rosa com o ícone do drive + nome + metadados
  (DriveItem.tagline, texto curado — sem contagens inventadas).
  Antes (2.7.6): o tile inteiro era ROSA. Foco via FocusAnimator.attachCard().
  Mesmos ids do celular (ViewBinding único).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drive_card_root"
    android:layout_width="@dimen/tv_drive_card_width"
    android:layout_height="@dimen/tv_drive_card_height"
    android:layout_marginEnd="@dimen/tv_rail_gap"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/elevation_0"
    app:cardBackgroundColor="@color/tile_bg"
    app:strokeWidth="0dp"
    app:strokeColor="@color/tile_focus_ring">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Onda 2 (a) — foto de capa do admin atrás do conteúdo do
             card (só quando o admin definiu cover_url; gone = o card
             segue exatamente como antes). Scrim = tile_overlay_bottom,
             o mesmo do hero. -->
        <ImageView
            android:id="@+id/drive_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:id="@+id/drive_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tile_overlay_bottom"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Quadrado rosa com o ícone do drive -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/drive_icon_square">

                <TextView
                    android:id="@+id/drive_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/drive_icon_tile_text"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Nome + metadados -->
            <TextView
                android:id="@+id/drive_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:ellipsize="end"
                android:maxLines="2"
                android:minLines="2"
                android:textColor="@color/tile_title"
                android:textSize="@dimen/tv_card_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/drive_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tile_subtitle"
                android:textSize="@dimen/tv_card_meta" />
        </LinearLayout>

        <!-- ★ Favorito do drive (na TV não é focável — v2.7.10) -->
        <TextView
            android:id="@+id/drive_fav_star"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:background="@drawable/badge_resume"
            android:clickable="true"
            android:contentDescription="@string/fav_desc"
            android:focusable="false"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/tile_title"
            android:textSize="16sp" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
