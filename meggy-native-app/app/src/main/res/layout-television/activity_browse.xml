<?xml version="1.0" encoding="utf-8"?>
<!--
  2.7.52 — Browse na TV (conceito tv-grade-drives): MESMOS ids da
  variante do celular (ViewBinding único; a navegação não muda).
  Diferenças só de apresentação: margens de overscan (56dp laterais),
  breadcrumb maior, grade com respiro p/ o anel de foco e o rodapé
  com as dicas do comando. A grade é de 5 colunas (BrowseActivity:
  spanCount=5 quando isTv).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Header (toolbar + accent line) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_primary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/bg_primary"
            android:elevation="0dp"
            android:paddingHorizontal="56dp"
            app:titleTextColor="@color/text_primary"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:navigationIconTint="@color/meggy_pink" />

        <!-- 1dp pink accent line under header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="#22FF8B9F" />
    </FrameLayout>

    <!-- Breadcrumb chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="56dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/breadcrumb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/breadcrumb_chip"
            android:paddingHorizontal="16dp"
            android:paddingVertical="9dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:singleLine="true"
            android:ellipsize="middle"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Grade de Tiles: 5 colunas na TV, margens de overscan. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingHorizontal="56dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical"
            android:scrollbarFadeDuration="0" />

        <ProgressBar
            android:id="@+id/loading_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/meggy_pink" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <!-- 2.7.56 (B16) — sem emoji gigante como "arte":
                 estados vazios/erro legíveis a 3 m são texto. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse_empty"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/error_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <!-- 2.7.56 (B16) — idem estado vazio: sem emoji 56sp. -->
            <TextView
                android:id="@+id/error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_button"
                style="@style/Widget.Meggy.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/browse_retry" />
        </LinearLayout>
    </FrameLayout>

    <!-- 2.7.52 — dicas do comando (conceito tv-grade-drives): só TV,
         texto pequeno e discreto. Sem id: nenhuma lógica o lê. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:text="@string/browse_tv_hints"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
