<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.8.0 — Staggered fade-in + slide-up for grid/rail tiles.
  Used by FileAdapter / RailAdapter / DriveRailAdapter in onBindViewHolder.
  Duration kept short (320ms) so the grid feels snappy on scroll.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@android:interpolator/decelerate_quint"
    android:fillEnabled="true"
    android:fillAfter="true">

    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />

    <translate
        android:fromYDelta="18%"
        android:toYDelta="0" />

    <scale
        android:fromXScale="0.94"
        android:fromYScale="0.94"
        android:toXScale="1"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%" />
</set>
