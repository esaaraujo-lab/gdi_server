<?xml version="1.0" encoding="utf-8"?>
<!--
  R22 UI — destaque em gradiente da linha de retoma na lista de
  aulas (só TV, aplicado por código em LessonAdapters quando a aula
  tem resume e não está assistida). Cantos 12dp.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/meggy_pink"
        android:endColor="@color/meggy_purple" />
</shape>
