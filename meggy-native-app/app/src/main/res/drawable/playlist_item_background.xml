<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.4.0 — Playlist item background selector.
  • Default: transparent
  • Focused (D-pad): pink border + subtle pink tint (so the user can see
    which item is selected when navigating with TV remote)
  • Current (set in code): stronger pink tint
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#22FF8B9F" />
            <stroke android:width="2dp" android:color="#FFFF8B9F" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#22FF8B9F" />
            <stroke android:width="2dp" android:color="#FFFF8B9F" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
