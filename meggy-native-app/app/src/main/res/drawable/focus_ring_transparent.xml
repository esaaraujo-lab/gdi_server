<?xml version="1.0" encoding="utf-8"?>
<!--
  Frente A (TV) — anel de foco para vistas sem fundo próprio (abas do
  detalhe, "Sair" da home, lupa do header TV). Em repouso é TRANSPARENTE
  (o visual não muda); focado, mostra o anel 3dp na cor da marca +
  fundo tile_bg_focused — o mesmo padrão de tile_focus_border, que tem
  fundo sólido em repouso e por isso não serve aqui.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/tile_bg_focused" />
            <stroke
                android:width="@dimen/focus_ring_width"
                android:color="@color/tile_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
