<?xml version="1.0" encoding="utf-8"?>
<!-- v2.7.6 — Anel de foco de TV (android-tv-design skill):
     borda 3dp na cor da marca (tile_focus_ring), raio 12dp, fundo
     surface quando focado. NÃO é só cor: o FocusAnimator adiciona
     escala (1.1× TV / 1.06× celular) + elevação 16dp + 180ms ease-out. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/tile_bg_focused" />
            <stroke
                android:width="@dimen/focus_ring_width"
                android:color="@color/tile_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@color/tile_bg" />
        </shape>
    </item>
</selector>
