<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused (D-pad) — bright accent border + subtle background change -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#252A38" />
            <stroke android:width="3dp" android:color="#FF8B9F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Pressed — slightly brighter -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A3040" />
            <stroke android:width="2dp" android:color="#5DDEDA" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Default — no border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
