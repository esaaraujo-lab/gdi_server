<?xml version="1.0" encoding="utf-8"?>
<!-- 2.7.48 — cartão vertical da grade da lista plana (conceito 2):
     thumb 16:9, título, meta e progresso. Mesmo conteúdo da linha
     horizontal (item_flat_lesson.xml), compacto, sem o botão
     "Continuar" — o estado vai no texto e na barra. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flatGridCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/elevation_0"
    app:cardBackgroundColor="@color/tile_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp">

            <View
                android:id="@+id/flatGridThumbBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/hero_dark_gradient" />

            <ImageView
                android:id="@+id/flatGridThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/thumb_desc" />

            <TextView
                android:id="@+id/flatGridMonogram"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/tile_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:alpha="0.95" />
        </FrameLayout>

        <TextView
            android:id="@+id/flatGridTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/md_on_surface"
            android:textSize="@dimen/text_card_subtitle"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flatGridMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="@dimen/text_chip" />

        <ProgressBar
            android:id="@+id/flatGridProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:max="100"
            android:progressDrawable="@drawable/progress_horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/flatGridProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/md_primary"
            android:textSize="@dimen/text_chip"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
