<?xml version="1.0" encoding="utf-8"?>
<!-- 2.7.58 — Linha da lista unificada de aulas (SPEC §2): miniatura
     16:9 do próprio vídeo + título (tema) + meta + selo "Aula
     atual" + progresso na base da miniatura. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/card_surface_rounded"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_sm">

    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="58dp">

        <ImageView
            android:id="@+id/unifiedThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ProgressBar
            android:id="@+id/unifiedProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressDrawable="@drawable/progress_horizontal"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/unifiedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/md_on_surface"
            android:textSize="@dimen/text_card_title" />

        <TextView
            android:id="@+id/unifiedMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="@dimen/text_card_subtitle" />

        <TextView
            android:id="@+id/unifiedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/chip_filter_selected"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/detail_current_lesson"
            android:textColor="@color/md_on_primary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
