<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.7.6 — Home celular (conceito 1): hero com badge em pílula, título
  grande, subtítulo, pill "Explorar →", dots clicáveis; seção
  "Continuar de onde parou" (TV — oculta no celular) + rail
  "Continue assistindo" com thumbs + progresso; "Explorar drives"
  com tile de ícone + nome + metadados; bottom nav flutuante
  arredondada (M3); rodapé "Meggy · vX" dinâmico.
  Sem hex/dp solto: tokens em dimens.xml / colors.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/content_margin"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Topo: logo + sair -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_topbar_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/topSair"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/spacing_sm"
                    android:text="@string/home_logout"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/text_topbar_action" />
            </LinearLayout>

            <!-- Hero -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_0"
                app:cardBackgroundColor="@color/tile_bg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/heroBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/card_gradient_pink" />

                    <!-- Marca do hero (monograma do título) -->
                    <TextView
                        android:id="@+id/heroIcon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/spacing_lg"
                        android:background="@drawable/btn_play_circle"
                        android:gravity="center"
                        android:textColor="@color/md_on_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/hero_text_padding_side"
                        android:paddingVertical="@dimen/spacing_xl">

                        <TextView
                            android:id="@+id/heroBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/chip_badge"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingVertical="@dimen/spacing_xs"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/text_hero_badge"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/text_hero_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/text_hero_subtitle" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/heroPlay"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="@dimen/spacing_lg"
                            android:background="@drawable/btn_primary_pill"
                            android:paddingHorizontal="@dimen/spacing_xl"
                            android:text="@string/explore_cta"
                            android:textColor="@color/md_on_primary"
                            android:textSize="@dimen/text_button"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/heroDots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/heroPrev"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/btn_play_circle"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="@color/md_on_surface"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/heroNext"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:background="@drawable/btn_play_circle"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="@color/md_on_surface"
                        android:textSize="24sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "Continuar de onde parou" — destaque (TV; oculto no celular) -->
            <LinearLayout
                android:id="@+id/featuredSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_from_where"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/featured_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/elevation_0"
                    app:cardBackgroundColor="@color/tile_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_lg">

                        <FrameLayout
                            android:layout_width="200dp"
                            android:layout_height="112dp">

                            <View
                                android:id="@+id/featuredBg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/card_gradient_pink" />

                            <ImageView
                                android:id="@+id/featuredThumb"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone"
                                android:contentDescription="@string/thumb_desc" />

                            <TextView
                                android:id="@+id/featuredMonogram"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="@color/tile_title"
                                android:textSize="@dimen/text_monogram"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_lg"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/featuredTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/md_on_surface"
                                android:textSize="@dimen/text_card_title"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/featuredSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/text_card_subtitle" />

                            <ProgressBar
                                android:id="@+id/featuredProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:max="100"
                                android:progressDrawable="@drawable/progress_horizontal" />

                            <TextView
                                android:id="@+id/featuredProgressText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/md_primary"
                                android:textSize="@dimen/text_card_progress" />

                            <TextView
                                android:id="@+id/featuredTimeText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/md_on_surface_variant"
                                android:textSize="@dimen/text_card_progress" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/featuredContinue"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:background="@drawable/btn_primary_pill"
                                android:paddingHorizontal="@dimen/spacing_xl"
                                android:text="@string/cta_continue"
                                android:textColor="@color/md_on_primary"
                                android:textSize="@dimen/text_button"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Continue assistindo -->
            <TextView
                android:id="@+id/labelContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/continue_watching"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_section_title"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/railContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <!-- Explorar drives -->
            <TextView
                android:id="@+id/labelDrives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/explore_drives"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_section_title"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/railDrives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/footerVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:gravity="center"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="@dimen/text_footer" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom nav flutuante (M3) — oculta na TV (código) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/content_margin"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@drawable/nav_bar_background"
        android:elevation="@dimen/elevation_3"
        app:itemActiveIndicatorStyle="@style/NavIndicatorPill"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
