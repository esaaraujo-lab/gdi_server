<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.7.6 — Home celular (conceito 1): hero com badge em pílula, título
  grande, subtítulo, pill "Explorar →", dots clicáveis; seção
  "Continuar de onde parou" (TV — oculta no celular) + rail
  "Continue assistindo" com thumbs + progresso; "Explorar drives"
  com tile de ícone + nome + metadados; bottom nav flutuante
  arredondada (M3); rodapé "Meggy · vX" dinâmico.
  Sem hex/dp solto: tokens em dimens.xml / colors.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:paddingHorizontal="@dimen/content_margin"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Topo: logo + sair -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_launcher_foreground_img" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/md_primary"
                    android:textSize="@dimen/text_topbar_title"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/homeSearchBtn"
                    android:layout_width="@dimen/button_height"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/home_search"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/md_on_surface" />

                <TextView
                    android:id="@+id/topSair"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/focus_ring_transparent"
                    android:focusableInTouchMode="true"
                    android:minHeight="@dimen/button_height"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_sm"
                    android:text="@string/home_logout"
                    android:textColor="@color/md_primary"
                    android:textSize="@dimen/text_topbar_action" />
            </LinearLayout>

            <!-- 2.7.41 (P1-13) — estados de carregamento/erro da home:
                 o conteúdo é local e monta depressa; o carregamento
                 cobre o 1.º desenho e o erro só aparece quando não há
                 nada local (sem recentes nem favoritos) E os destaques
                 falharam (ver HomeActivity.updateHomeStateViews). -->
            <LinearLayout
                android:id="@+id/homeLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@drawable/skeleton_block" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/skeleton_block" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/skeleton_block" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/home_loading"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/text_card_subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/home_error"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="@dimen/text_card_subtitle" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/homeRetry"
                    style="@style/Widget.Meggy.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/browse_retry" />
            </LinearLayout>

            <!-- Hero -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_0"
                app:cardBackgroundColor="@color/tile_bg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/heroBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/hero_dark_gradient" />

                    <!-- Foto real do destaque (Coil) + scrim escuro para o texto -->
                    <ImageView
                        android:id="@+id/heroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@string/thumb_desc" />

                    <View
                        android:id="@+id/heroScrim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/tile_overlay_bottom"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/hero_text_padding_side"
                        android:paddingVertical="@dimen/spacing_xl">

                        <TextView
                            android:id="@+id/heroBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/chip_badge"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingVertical="@dimen/spacing_xs"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/text_hero_badge"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/md_on_surface"
                            android:textSize="@dimen/text_hero_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/heroSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/md_on_surface_variant"
                            android:textSize="@dimen/text_hero_subtitle" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/heroPlay"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="@dimen/spacing_lg"
                            android:background="@drawable/btn_primary_pill"
                            android:paddingHorizontal="@dimen/spacing_xl"
                            android:text="@string/explore_cta"
                            android:textColor="@color/md_on_primary"
                            android:textSize="@dimen/text_button"
                            android:textStyle="bold" />

                    </LinearLayout>

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- R22 UI (conceito "início celular"): "Continuar assistindo"
                 em cartão largo — capa, curso+aula, "faltam MM:SS", barra
                 cheia e botão. Na TV o layout-television mantém a forma
                 anterior; os ids são os mesmos nos dois recursos. -->
            <LinearLayout
                android:id="@+id/featuredSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_from_where"
                    android:textColor="@color/md_on_surface"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/featured_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/elevation_0"
                    app:cardBackgroundColor="@color/tile_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="120dp"
                                android:layout_height="68dp">

                                <View
                                    android:id="@+id/featuredBg"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/hero_dark_gradient" />

                                <ImageView
                                    android:id="@+id/featuredThumb"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone"
                                    android:contentDescription="@string/thumb_desc" />

                                <TextView
                                    android:id="@+id/featuredFallbackIcon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:textColor="@color/tile_title"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:alpha="0.95" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/featuredTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="@color/md_on_surface"
                                    android:textSize="@dimen/text_card_title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/featuredSubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/md_on_surface_variant"
                                    android:textSize="@dimen/text_card_subtitle" />

                                <TextView
                                    android:id="@+id/featuredTimeText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/md_on_surface_variant"
                                    android:textSize="@dimen/text_card_progress" />
                            </LinearLayout>
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/featuredProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_horizontal" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/featuredProgressText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/md_primary"
                                android:textSize="@dimen/text_card_progress" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/featuredContinue"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:background="@drawable/btn_primary_pill"
                                android:paddingHorizontal="@dimen/spacing_xl"
                                android:text="@string/continue_watching"
                                android:textColor="@color/md_on_primary"
                                android:textSize="@dimen/text_button"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Continue assistindo -->
            <TextView
                android:id="@+id/labelContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/continue_watching"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_section_title"
                android:textStyle="bold" />

            <!-- R15C (ronda 15, frente C): halo de foco TV — 16dp laterais / 12dp verticais + sem corte (clipChildren=false). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/railContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:clipChildren="false"
                android:overScrollMode="never" />

            <!-- R22 UI (conceito "início celular"): "Meus cursos" em
                 grelha de 2 colunas — os cursos favoritos do aluno
                 (mesma fonte da Minha Lista) com total real (unified)
                 e progresso local. Só no celular: ids novos, lidos
                 por findViewById com guarda de plataforma. -->
            <TextView
                android:id="@+id/labelMyCourses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_margin"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/home_my_courses"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_section_title"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gridMyCourses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/content_margin"
                android:paddingEnd="@dimen/content_margin"
                android:visibility="gone" />

            <!-- R22 UI: "Destaques" em cartões horizontais — cursos em
                 destaque da API; sem resposta, os itens curados do
                 hero. Só no celular. -->
            <TextView
                android:id="@+id/labelDestaques"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_margin"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/home_highlights"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_section_title"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listDestaques"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/content_margin"
                android:paddingEnd="@dimen/content_margin"
                android:visibility="gone" />

            <!-- Explorar drives -->
            <TextView
                android:id="@+id/labelDrives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/explore_drives"
                android:textColor="@color/md_on_surface"
                android:textSize="@dimen/text_section_title"
                android:textStyle="bold" />

            <!-- R15C (ronda 15, frente C): halo de foco TV — 16dp laterais / 12dp verticais + sem corte (clipChildren=false). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/railDrives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:clipChildren="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/footerVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:gravity="center"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="@dimen/text_footer" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom nav flutuante (M3) — oculta na TV (código) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/content_margin"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@drawable/nav_bar_background"
        android:elevation="@dimen/elevation_3"
        app:itemActiveIndicatorStyle="@style/NavIndicatorPill"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
