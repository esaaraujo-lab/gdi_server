<?xml version="1.0" encoding="utf-8"?>
<!-- R22 UI (conceito "início celular"): cartão horizontal da seção
     "Destaques" — capa à esquerda, título, subtítulo e selo quando o
     dado real o traz (itens curados do hero). Só no celular. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/featured_card_width"
    android:layout_height="wrap_content"
    android:background="@drawable/card_surface_rounded"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="64dp">

        <View
            android:id="@+id/homeFeaturedBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/homeFeaturedThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/homeFeaturedMonogram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/md_on_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/homeFeaturedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_badge"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/md_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/homeFeaturedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/md_on_surface"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeFeaturedSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="@dimen/text_card_subtitle"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
