<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="12dp"
    android:focusable="true" android:focusableInTouchMode="true" android:clickable="true"
    android:foreground="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/card_gradient_pink"
        android:layout_marginBottom="8dp">
        <TextView android:id="@+id/drive_icon"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textSize="44sp" />
    </FrameLayout>

    <TextView android:id="@+id/drive_name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#E6EDF3" android:textSize="12sp" android:textStyle="bold"
        android:gravity="center" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
