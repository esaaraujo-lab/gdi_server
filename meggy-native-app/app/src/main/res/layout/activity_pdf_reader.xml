<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.7.15 — Leitor de PDF (Frente I): scroll contínuo em tela
  cheia (RecyclerView vertical, uma página por item); no celular
  desliza-se para baixo entre páginas — sem botões gigantes.
  Barra inferior fina: ‹ › + zoom −/+ pequenos (36dp, 16sp),
  rótulo da página (toque = ir para página) e bookmark.
  Zoom por botões + pinch (um passo por gesto); ao ampliar, a
  página rola na horizontal dentro do item. Toolbar 56dp com
  "<" (voltar) de tamanho normal. TV: mesmos controlos
  focáveis por D-pad; o RecyclerView recebe o foco e rola
  com as setas. Busca/bookmark/compartilhar: inalterados.
  Frente J: botão "✨ Resumo" na toolbar (btnSummary) — gera o resumo do PDF pela Meggy.
  Frente R5B: no celular as barras escondem-se sozinhas ~3 s sem interação
  (ver PdfReaderActivity); a barra inferior tem id bottomControlsBar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/md_background"
        android:elevation="0dp"
        app:navigationIconTint="@color/md_primary"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="@color/md_on_surface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="Buscar no texto"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_search"
                android:tint="@color/md_on_surface" />

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="Compartilhar"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_share"
                android:tint="@color/md_on_surface" />

            <!-- Frente J — botão "Gerar resumo" (Meggy, no servidor). -->
            <TextView
                android:id="@+id/btnSummary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="Gerar resumo com a Meggy"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="✨ Resumo"
                android:textColor="@color/md_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Barra de busca no texto -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/content_margin"
        android:paddingVertical="@dimen/spacing_sm"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:boxBackgroundColor="@color/md_surface_container"
            app:boxCornerRadiusTopStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxStrokeWidth="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buscar no texto…"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/md_on_surface"
                android:textColorHint="@color/md_on_surface_variant"
                android:textSize="@dimen/text_card_subtitle" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/searchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="@dimen/text_card_subtitle" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSearchPrev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/chip_outline"
            android:focusable="true"
            android:text="‹"
            android:textColor="@color/md_on_surface"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSearchNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="@drawable/chip_outline"
            android:focusable="true"
            android:text="›"
            android:textColor="@color/md_on_surface"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Páginas em scroll contínuo (Frente I): RecyclerView vertical;
         cada página é um item; deslizar para baixo muda de página. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pdfPages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/loadingView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/errorView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="@dimen/text_detail_body"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Barra inferior: página + zoom + bookmark -->
    <!-- Frente R5B — id p/ o auto-hide das barras no celular. -->
    <LinearLayout
        android:id="@+id/bottomControlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_sm">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPrevPage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/chip_outline"
                android:focusable="true"
                android:text="‹"
                android:textColor="@color/md_on_surface"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/pageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true"
                android:text="Página 1 de 1"
                android:textColor="@color/md_primary"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNextPage"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/chip_outline"
                android:focusable="true"
                android:text="›"
                android:textColor="@color/md_on_surface"
                android:textSize="16sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnZoomOut"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/chip_outline"
            android:focusable="true"
            android:text="−"
            android:textColor="@color/md_on_surface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/zoomLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:text="100%"
            android:textColor="@color/md_on_surface"
            android:textSize="@dimen/text_card_title"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnZoomIn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/chip_outline"
            android:focusable="true"
            android:text="+"
            android:textColor="@color/md_on_surface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnBookmark"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:background="@drawable/chip_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/md_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Bottom nav (conceito) — oculta na TV (código) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/content_margin"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@drawable/nav_bar_background"
        android:elevation="@dimen/elevation_3"
        app:itemActiveIndicatorStyle="@style/NavIndicatorPill"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
